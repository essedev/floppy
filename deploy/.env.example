# Every variable of deploy/docker-compose.yml. In Dokploy: the compose's Environment tab; by
# hand: copy to deploy/.env (outside git) and pass --env-file deploy/.env. No real value is
# ever committed, the domain included. Generate the secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# and FLOPPY_SECRET_KEY with:
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"

# The instance's domain: the admin web and the API at https://<domain>, the disks' metadata
# at <label>.meta.<domain>. DNS: an A (and AAAA) record for <domain> and one for
# *.meta.<domain>, both to the host.
FLOPPY_DOMAIN=

# Encryption of stored secrets (DECISIONS #17): 32 random bytes, base64. Keep a copy outside
# the host; losing it loses no files, but S3 and SMTP secrets must be typed again.
FLOPPY_SECRET_KEY=

# PostgreSQL: the owner runs migrations, the application's role has no DELETE.
FLOPPY_DB_OWNER_PASSWORD=
FLOPPY_DB_APP_PASSWORD=

# The meta service: the control plane's token, and the routes token Traefik sends (it reads
# the routes and nothing else; it also goes in Traefik's static configuration). 32 characters
# or more each, different.
FLOPPY_META_TOKEN=
FLOPPY_META_ROUTES_TOKEN=
# The meta service's name on Traefik's network, also the prefix of its routers: change it
# only to run two Floppy instances behind one Traefik.
# FLOPPY_META_ALIAS=floppy-meta
# The resolver that obtains *.meta.<domain> by DNS challenge (deploy/traefik/traefik.yml).
# FLOPPY_META_CERT_RESOLVER=floppy-dns
# always (every write on disk before the answer, the default) or everysec.
# FLOPPY_META_APPENDFSYNC=always

# Traefik: its network (Dokploy's), entrypoints, the resolver of the web's certificate
# (Dokploy's HTTP challenge) and the prefix of the HTTP routers' names.
# FLOPPY_PROXY_NETWORK=dokploy-network
# FLOPPY_TRAEFIK_ENTRYPOINT=websecure
# FLOPPY_TRAEFIK_HTTP_ENTRYPOINT=web
# FLOPPY_WEB_CERT_RESOLVER=letsencrypt
# FLOPPY_ROUTER_PREFIX=floppy
# The subnet of Traefik's network, whose X-Forwarded-For the control plane believes (the
# rate limits count the client's address):
#   docker network inspect dokploy-network -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
FLOPPY_TRUSTED_PROXIES=
# The private network of the database and the meta service; change it if it collides.
# FLOPPY_INTERNAL_SUBNET=10.250.49.0/24

# Mail: sign-in links and invitations go through SMTP.
FLOPPY_SMTP_HOST=
FLOPPY_SMTP_PORT=587
FLOPPY_SMTP_USERNAME=
FLOPPY_SMTP_PASSWORD=
FLOPPY_SMTP_SENDER=Floppy <floppy@example.com>
FLOPPY_SMTP_STARTTLS=true

# The first organization, created at the first start when none exists (or later with
# `floppy-server bootstrap --from-env`). The endpoint and region are the defaults of new disks.
FLOPPY_BOOTSTRAP_ORGANIZATION_NAME=
FLOPPY_BOOTSTRAP_ORGANIZATION_SLUG=
FLOPPY_BOOTSTRAP_ADMIN_EMAIL=
FLOPPY_BOOTSTRAP_S3_ENDPOINT=
FLOPPY_BOOTSTRAP_S3_REGION=
# it or en, the organization's mail language.
FLOPPY_BOOTSTRAP_MAIL_LANGUAGE=it
# manual (a bucket and a key pasted per disk, any S3) or managed (a provider adapter, with its
# admin credentials as JSON). Fixed once a disk exists (DECISIONS #24).
FLOPPY_BOOTSTRAP_STORAGE_MODE=manual
# FLOPPY_BOOTSTRAP_STORAGE_PROVIDER=
# FLOPPY_BOOTSTRAP_STORAGE_ADMIN_CREDENTIALS=

# A directory with the patched juicefs already built (spike/juicefs-replica/build.sh), to skip
# compiling it in the build; unset, Compose builds it from the patches.
# FLOPPY_JUICEFS_DIST=
