---
// Starlight Search override: Starlight's own search (Pagefind dialog, shortcut, translations),
// with its trigger drawn as a sunken field, the LED bezel at field size, and the shortcut as
// a readout. Starlight's styles sit in cascade layers, so these unlayered rules win without
// !important; they rely only on the trigger's `data-open-modal` attribute.
import Default from '@astrojs/starlight/components/Search.astro';
---

<Default {...Astro.props} />

<style is:global>
  site-search > button[data-open-modal] {
    color: var(--ink-2);
  }
  site-search > button[data-open-modal]:hover {
    color: var(--ink);
  }
  site-search > button[data-open-modal]:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  @media (min-width: 50rem) {
    site-search > button[data-open-modal] {
      height: 2.25rem;
      border: 0;
      border-radius: 10px;
      background: var(--bezel);
      box-shadow:
        inset 0 1px 2px rgba(0, 0, 0, 0.3),
        0 1px 0 var(--bezel-lift);
    }
    site-search > button[data-open-modal]:hover {
      border: 0;
    }
  }
  site-search > button[data-open-modal] > kbd {
    padding: 0.2rem 0.4rem;
    border-radius: 5px;
    background: var(--raised);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.18);
    color: var(--ink-2);
    font-family: var(--f-ro);
    font-size: 11px;
  }
  site-search > button[data-open-modal] > kbd kbd {
    font-family: var(--f-ro);
  }
</style>
