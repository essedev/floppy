---
// Starlight SocialIcons override: the same links as the landing's header: the docs, sign-in
// on the hosted service and the repository.
import { Icon } from '@astrojs/starlight/components';
import { brand } from '@/brand';
import { chrome } from '@/i18n/chrome';
import { langOf, localePath } from '@/lib/locale';

const lang = langOf(Astro.locals.starlightRoute.lang);
---

<a class="fx-head-link" href={localePath(lang, '/introduction/')}>{chrome[lang].docs}</a>
<a class="fx-head-link" href={brand.dashboard}>{chrome[lang].signIn}</a>
<a class="fx-head-link fx-head-icon" href={brand.repo} rel="me">
  <Icon name="github" size="1.15rem" />
  <span class="sr-only">GitHub</span>
</a>

<style>
  .fx-head-link {
    display: inline-flex;
    align-items: center;
    color: var(--ink-2);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
  }
  .fx-head-link:hover {
    color: var(--ink);
  }
  .fx-head-link:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
    border-radius: 4px;
  }
</style>
