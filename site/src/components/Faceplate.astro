---
// The Grafite drive faceplate from concept C, in the download state: the slot fills with the
// cache, the orange head is the block arriving, the LED is the state. Same dark body in both
// themes. Static on purpose: the LED blinks only for real activity, and this is a picture.
import { brand } from '@/brand';

interface Props {
  /** Accessible description of the picture. */
  label: string;
  /** Cache readout under the slot, already localized. */
  used: string;
  /** State readout under the LED. */
  state: string;
}

const { label, used, state } = Astro.props;
// 48.2 GB of 100 on a 206-unit slot, as in the concept.
const fill = Math.round((48.2 / 100) * 206);
---

<svg class="faceplate" viewBox="0 0 336 112" role="img" aria-label={label}>
  <defs>
    <linearGradient id="fx-face-body" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#3a3835"></stop>
      <stop offset="1" stop-color="#1c1b19"></stop>
    </linearGradient>
  </defs>
  <rect x=".5" y=".5" width="335" height="111" rx="12" fill="url(#fx-face-body)" stroke="#0f0f0e"></rect>
  <rect x="1.5" y="1.5" width="333" height="109" rx="11" fill="none" stroke="#fff" stroke-opacity=".08"></rect>
  <rect x="24" y="34" width="212" height="12" rx="6" fill="#0b0b0a"></rect>
  <rect x="27" y="37" width={fill} height="6" rx="3" fill="#d9d4c8"></rect>
  <rect x={27 + fill - 14} y="37" width="14" height="6" rx="3" fill="#ff6a2e"></rect>
  <text x="24" y="76" font-family="Schibsted Grotesk" font-weight="800" font-size="15" letter-spacing="-.4" fill="#8f8b83">{brand.slug}</text>
  <text x="236" y="76" text-anchor="end" font-family="Departure Mono" font-size="11" fill="#b3aea5">{used}</text>
  <circle cx="290" cy="40" r="10" fill="#0b0b0a"></circle>
  <circle cx="290" cy="40" r="5.5" fill="#ff6a2e"></circle>
  <ellipse cx="290" cy="37.6" rx="2.6" ry="1.4" fill="#fff" opacity=".5"></ellipse>
  <text x="290" y="76" text-anchor="middle" font-family="Departure Mono" font-size="10" letter-spacing=".5" fill="#b3aea5">{state}</text>
</svg>

<style>
  .faceplate {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 18px 28px rgba(20, 14, 8, 0.28));
  }
</style>
