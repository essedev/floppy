---
// The Grafite drive faceplate (design/mark/faceplate.svg) as the hero object, with the LED
// legend under it. The same dark body in both themes, colours from the --plate-* and
// --led-*-plate tokens. It plays the panel's states in a loop: connected, a project
// downloading (the slot fills, its leading block and the LED blink), connected again, then the
// project freed. With prefers-reduced-motion it stays still on Connected.
import { brand, type Lang } from '@/brand';
import type { LandingStrings } from '@/i18n/landing';

interface Props {
  /** Language, for the number format of the readouts. */
  lang: Lang;
  /** Faceplate strings, already localized. */
  t: LandingStrings['faceplate'];
}

const { lang, t } = Astro.props;

/** Cache in use at rest, and the cache limit, in GB (the concept's numbers). */
const used = 48.2;
const limit = 100;
/** Inner width of the slot in SVG units. */
const slot = 206;
const fill = Math.round((used / limit) * slot);
const usedText = `${used.toLocaleString(lang, { minimumFractionDigits: 1 })} / ${limit} GB`;
const legend = (['ok', 'dl', 'err', 'off'] as const).map((state) => ({ state, label: t.states[state] }));
---

<div class="fp" data-faceplate data-lang={lang} data-ok={t.plateOk} data-used={used} data-limit={limit}>
  <svg class="fp-plate" viewBox="0 0 336 112" role="img" aria-label={t.label}>
    <defs>
      <linearGradient id="fp-body" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" class="fp-hi"></stop>
        <stop offset="1" class="fp-lo"></stop>
      </linearGradient>
    </defs>
    <rect x=".5" y=".5" width="335" height="111" rx="12" fill="url(#fp-body)" class="fp-edge"></rect>
    <rect x="1.5" y="1.5" width="333" height="109" rx="11" fill="none" stroke="#fff" stroke-opacity=".08"></rect>
    <rect x="24" y="34" width="212" height="12" rx="6" class="fp-slot"></rect>
    <rect x="27" y="37" width={fill} height="6" rx="3" class="fp-fill" data-fill></rect>
    <rect x={27 + fill - 14} y="37" width="14" height="6" rx="3" class="fp-head" data-head></rect>
    <text x="24" y="76" class="fp-word">{brand.slug}</text>
    <text x="236" y="76" text-anchor="end" class="fp-ro" data-used-text>{usedText}</text>
    <circle cx="290" cy="40" r="10" class="fp-slot"></circle>
    <circle cx="290" cy="40" r="5.5" class="fp-lens" data-lens data-state="ok"></circle>
    <ellipse cx="290" cy="37.6" rx="2.6" ry="1.4" fill="#fff" opacity=".5"></ellipse>
    <text x="290" y="76" text-anchor="middle" class="fp-ro fp-state" data-state-text>{t.plateOk}</text>
  </svg>
  <ul class="fp-legend">
    {
      legend.map(({ state, label }) => (
        <li data-legend={state} class:list={{ 'is-current': state === 'ok' }}>
          <span class="led" data-state={state === 'off' ? undefined : state} aria-hidden="true" />
          <span class="readout">{label}</span>
        </li>
      ))
    }
  </ul>
</div>

<script>
  // The loop is a timeline of phases; frames advance only while the faceplate is on screen
  // and the tab is visible, so nothing runs in the background.
  type Phase = { state: 'ok' | 'dl'; ms: number; from: number; to: number };

  const SLOT = 206;
  const HEAD = 14;

  function start(root: HTMLElement) {
    const fill = root.querySelector<SVGRectElement>('[data-fill]');
    const head = root.querySelector<SVGRectElement>('[data-head]');
    const lens = root.querySelector<SVGCircleElement>('[data-lens]');
    const usedText = root.querySelector<SVGTextElement>('[data-used-text]');
    const stateText = root.querySelector<SVGTextElement>('[data-state-text]');
    if (!fill || !head || !lens || !usedText || !stateText) return;

    const lang = root.dataset.lang ?? 'en';
    const okText = root.dataset.ok ?? '';
    const rest = Number(root.dataset.used);
    const limit = Number(root.dataset.limit);
    const project = 13.6;
    const gb = new Intl.NumberFormat(lang, { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    const phases: Phase[] = [
      { state: 'ok', ms: 2600, from: rest, to: rest },
      { state: 'dl', ms: 6400, from: rest, to: rest + project },
      { state: 'ok', ms: 3200, from: rest + project, to: rest + project },
      { state: 'ok', ms: 700, from: rest + project, to: rest },
    ];
    const total = phases.reduce((sum, p) => sum + p.ms, 0);
    const legend = [...root.querySelectorAll<HTMLElement>('[data-legend]')];

    let visible = true;
    let elapsed = 0;
    let last = performance.now();
    let current = '';

    function draw(t: number) {
      let at = t % total;
      let phase = phases[0];
      for (const p of phases) {
        phase = p;
        if (at < p.ms) break;
        at -= p.ms;
      }
      const k = Math.min(1, at / phase.ms);
      const ease = k < 0.5 ? 2 * k * k : 1 - (-2 * k + 2) ** 2 / 2;
      const value = phase.from + (phase.to - phase.from) * (phase.state === 'dl' ? k : ease);
      const width = Math.max(6, (value / limit) * SLOT);
      fill!.setAttribute('width', width.toFixed(1));
      head!.setAttribute('x', (27 + width - HEAD).toFixed(1));
      usedText!.textContent = `${gb.format(value)} / ${limit} GB`;
      stateText!.textContent = phase.state === 'dl' ? `${Math.floor(k * 100)}%` : okText;
      if (phase.state !== current) {
        current = phase.state;
        lens!.dataset.state = current;
        root.classList.toggle('is-downloading', current === 'dl');
        for (const li of legend) li.classList.toggle('is-current', li.dataset.legend === current);
      }
    }

    function frame(now: number) {
      if (visible && !document.hidden) elapsed += now - last;
      last = now;
      draw(elapsed);
      requestAnimationFrame(frame);
    }

    new IntersectionObserver(([entry]) => (visible = entry.isIntersecting)).observe(root);
    requestAnimationFrame(frame);
  }

  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    for (const root of document.querySelectorAll<HTMLElement>('[data-faceplate]')) start(root);
  }
</script>

<style>
  .fp-plate {
    display: block;
    width: 100%;
    height: auto;
    filter: drop-shadow(0 18px 28px rgba(20, 14, 8, 0.28));
  }
  .fp-hi {
    stop-color: var(--plate-hi);
  }
  .fp-lo {
    stop-color: var(--plate-lo);
  }
  .fp-edge {
    stroke: var(--plate-edge);
  }
  .fp-slot {
    fill: var(--plate-slot);
  }
  .fp-fill {
    fill: var(--plate-fill);
  }
  /* The block arriving: the fill's own colour, blinking with the LED while downloading.
     Colour lives only in the LED. */
  .fp-head {
    fill: var(--plate-fill);
    opacity: 0;
  }
  .is-downloading .fp-head {
    opacity: 1;
  }
  .fp-lens {
    fill: var(--led-ok-plate);
  }
  .fp-lens[data-state='dl'] {
    fill: var(--led-dl-plate);
  }
  .is-downloading :is(.fp-head, .fp-lens) {
    animation: fp-blink 1.1s steps(2, jump-none) infinite;
  }
  @keyframes fp-blink {
    50% {
      opacity: 0.15;
    }
  }
  /* Text colours on the dark body, as in design/mark/faceplate.svg: the tokens have none. */
  .fp-word {
    fill: #8f8b83;
    font-family: var(--f-ui);
    font-weight: 800;
    font-size: 15px;
    letter-spacing: -0.4px;
  }
  .fp-ro {
    fill: #b3aea5;
    font-family: var(--f-ro);
    font-size: 11px;
  }
  .fp-state {
    font-size: 10px;
    letter-spacing: 0.5px;
  }

  .fp-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .fp-legend li {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0;
  }
  .fp-legend li.is-current .readout {
    color: var(--ink);
  }
</style>
