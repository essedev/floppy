---
// The landing's opening: tagline, lead, the two ways in, requirements, and the drive
// faceplate as the object the page is about.
import { brand, type Lang } from '@/brand';
import { landing } from '@/i18n/landing';
import { localePath } from '@/lib/locale';
import Faceplate from './Faceplate.astro';

interface Props {
  /** Language of the page. */
  lang: Lang;
}

const { lang } = Astro.props;
const t = landing[lang];
---

<section class="fx-hero fx-wrap" aria-labelledby="fx-title">
  <div class="fx-hero-text">
    <h1 id="fx-title">{brand.tagline[lang]}</h1>
    <p class="fx-lead">{t.lead}</p>
    <div class="fx-actions">
      <a class="fx-btn fx-btn-primary" href="#fx-install">{t.installCta}</a>
      <a class="fx-btn" href={localePath(lang, '/introduction/')}>{t.docsCta}</a>
    </div>
    <p class="readout fx-req">{t.requirements}</p>
  </div>
  <figure class="fx-hero-face">
    <Faceplate lang={lang} t={t.faceplate} />
    <figcaption>{t.faceplate.caption}</figcaption>
  </figure>
</section>

<style>
  .fx-hero {
    display: grid;
    gap: 3rem;
    align-items: center;
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 6.5rem) clamp(3rem, 2rem + 5vw, 7rem);
  }
  @media (min-width: 60rem) {
    .fx-hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: clamp(3rem, 6vw, 6rem);
    }
  }
  h1 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.4rem, 1.5rem + 3vw, 3.6rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .fx-lead {
    margin: 1.5rem 0 0;
    max-width: 33rem;
    color: var(--ink-2);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    line-height: 1.6;
  }
  .fx-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  .fx-req {
    margin: 2rem 0 0;
    max-width: 30rem;
    line-height: 1.7;
  }
  .fx-hero-face {
    margin: 0;
  }
  figcaption {
    margin-top: 1.25rem;
    max-width: 30rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
</style>
