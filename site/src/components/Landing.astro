---
// The landing page in one language: a Starlight splash page whose hero is overridden
// (components/Hero.astro), followed by the three properties, how it works, install and links.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Code } from '@astrojs/starlight/components';
import { brand, type Lang } from '@/brand';
import { landing } from '@/i18n/landing';
import { localePath } from '@/lib/locale';
import Diagram from './Diagram.astro';

interface Props {
  /** Language of the page. */
  lang: Lang;
}

const { lang } = Astro.props;
const t = landing[lang];
const installLine = `brew install --cask ${brand.cask}`;
---

<StarlightPage
  frontmatter={{
    title: t.pageTitle,
    description: brand.tagline[lang],
    template: 'splash',
    hero: { title: brand.tagline[lang] },
    pagefind: false,
  }}
>
  <div class="not-content fx-landing">
    <section class="fx-section" aria-labelledby="fx-what">
      <h2 id="fx-what">{t.propertiesTitle}</h2>
      <ul class="fx-props">
        {
          t.properties.map((p) => (
            <li>
              <h3>
                <span class="fx-slot" aria-hidden="true" />
                {p.title}
              </h3>
              <p>{p.text}</p>
              <p class="fx-readout">{p.readout}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="fx-section" aria-labelledby="fx-how">
      <h2 id="fx-how">{t.howTitle}</h2>
      <p class="fx-section-lead">{t.howLead}</p>
      <Diagram t={t.diagram} />
      <ul class="fx-traffic">
        {
          t.traffic.map((k) => (
            <li>
              <svg class="fx-stroke" viewBox="0 0 44 10" aria-hidden="true">
                <path class={`fx-stroke-${k.kind}`} d="M3 5 H41" />
              </svg>
              <div>
                <h3>{k.title}</h3>
                <p>{k.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="fx-section fx-install" aria-labelledby="fx-install">
      <div>
        <h2 id="fx-install">{t.installTitle}</h2>
        <p>{t.installText}</p>
        <p class="fx-status">
          <span class="fx-led" aria-hidden="true" />
          <span class="fx-readout">{t.installStatus}</span>
        </p>
      </div>
      <div class="fx-install-cmd">
        <Code code={installLine} lang="sh" frame="none" />
        <a href={localePath(lang, '/install/')}>{t.installMore}</a>
      </div>
    </section>

    <nav class="fx-section fx-more" aria-labelledby="fx-more">
      <h2 id="fx-more">{t.linksTitle}</h2>
      <ul>
        <li><a href={localePath(lang, '/introduction/')}>{t.links.docs}</a></li>
        <li><a href={localePath(lang, '/self-hosting/')}>{t.links.selfHosting}</a></li>
        <li><a href={localePath(lang, '/licenses/')}>{t.links.licenses}</a></li>
        <li><a href={brand.repo}>{t.links.github}</a></li>
      </ul>
    </nav>
  </div>
</StarlightPage>

<style is:global>
  /* The landing sits on the page tone; doc pages read on the lighter surface. */
  :root:has(.fx-landing) {
    --sl-color-bg: var(--fx-page);
  }
</style>

<style>
  .fx-landing {
    color: var(--sl-color-gray-2);
  }
  .fx-section {
    padding-block: 3.5rem;
    border-top: 1px solid var(--fx-line);
  }
  h2 {
    margin: 0 0 1.75rem;
    color: var(--sl-color-white);
    font-size: clamp(1.6rem, 1.3rem + 1.2vw, 2.1rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }
  h3 {
    margin: 0;
    color: var(--sl-color-white);
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  p {
    margin: 0;
    line-height: 1.6;
  }
  .fx-section-lead {
    max-width: 44rem;
    margin-bottom: 2.25rem;
    font-size: 1.0625rem;
  }

  .fx-props {
    display: grid;
    gap: 2.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 50rem) {
    .fx-props {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }
  .fx-props h3 {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .fx-props p {
    margin-top: 0.75rem;
  }
  .fx-props .fx-readout {
    margin-top: 1rem;
  }
  .fx-slot {
    flex: none;
    width: 12px;
    height: 4px;
    border-radius: 2px;
    background: var(--fx-ink-3);
    box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.3);
    transform: translateY(-0.2em);
  }

  .fx-traffic {
    display: grid;
    gap: 1.5rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 50rem) {
    .fx-traffic {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
    }
  }
  .fx-traffic li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 0.9rem;
  }
  .fx-traffic h3 {
    font-size: 1.0625rem;
  }
  .fx-traffic p {
    margin-top: 0.4rem;
  }
  .fx-stroke {
    width: 44px;
    height: 10px;
    margin-top: 0.5rem;
  }
  .fx-stroke path {
    fill: none;
    stroke-linecap: round;
  }
  .fx-stroke-data {
    stroke: var(--fx-ink);
    stroke-width: 5;
  }
  .fx-stroke-meta {
    stroke: var(--fx-ink-2);
    stroke-width: 1.75;
  }
  .fx-stroke-ctl {
    stroke: var(--fx-ink-2);
    stroke-width: 1.75;
    stroke-dasharray: 2 5;
  }

  .fx-install {
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }
  @media (min-width: 56rem) {
    .fx-install {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }
  .fx-install h2 {
    margin-bottom: 1rem;
  }
  .fx-install p {
    max-width: 32rem;
  }
  .fx-status {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }
  .fx-install-cmd {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }
  .fx-install-cmd a,
  .fx-more a {
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--fx-ink-3);
    text-underline-offset: 0.2em;
  }
  .fx-install-cmd a:hover,
  .fx-more a:hover {
    text-decoration-color: currentColor;
  }

  .fx-more ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fx-more h2 {
    margin-bottom: 1.25rem;
    font-size: 1.25rem;
  }
</style>
