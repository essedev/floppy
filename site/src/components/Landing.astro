---
// The landing page in one language, on its own layout (layouts/LandingLayout.astro): the
// hero, who it is for, what teams use it for and where it does not fit, how it works in plain
// words, storage and price, licenses and hosting, install on a faceplate panel, and links on.
// Technical detail and tables live in the docs, one link away from each section. Sections
// alternate between the page and the surface tone so the page reads as one object in bands.
import { brand, type Lang } from '@/brand';
import { landing } from '@/i18n/landing';
import { localePath } from '@/lib/locale';
import LandingLayout from '@/layouts/LandingLayout.astro';
import Diagram from './Diagram.astro';
import Hero from './Hero.astro';

interface Props {
  /** Language of the page. */
  lang: Lang;
}

const { lang } = Astro.props;
const t = landing[lang];
const other: Lang = lang === 'en' ? 'it' : 'en';
const installLine = `brew install --cask ${brand.caskRef}`;
---

<LandingLayout lang={lang} title={t.pageTitle} description={t.description}>
  <Hero lang={lang} />

  <section class="fx-band fx-band-alt" aria-labelledby="fx-who">
    <div class="fx-wrap fx-split">
      <div class="fx-split-head">
        <h2 id="fx-who">{t.whoTitle}</h2>
        <p class="fx-lead">{t.whoLead}</p>
      </div>
      <ul class="fx-props">
        {
          t.benefits.map((b) => (
            <li>
              <h3>
                <span class="slot-mark" aria-hidden="true" />
                {b.title}
              </h3>
              <p>{b.text}</p>
              <p class="readout">{b.readout}</p>
              <a class="fx-more-link" href={localePath(lang, b.more.path)}>
                {b.more.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="fx-band" aria-labelledby="fx-uses">
    <div class="fx-wrap">
      <div class="fx-head">
        <h2 id="fx-uses">{t.usesTitle}</h2>
        <p class="fx-lead">{t.usesLead}</p>
      </div>
      <ul class="fx-uses">
        {
          t.uses.map((u) => (
            <li>
              <h3>{u.title}</h3>
              <p class="readout">{u.who}</p>
              <p>{u.text}</p>
            </li>
          ))
        }
      </ul>
      <div class="fx-notfit">
        <h3>{t.notFitTitle}</h3>
        <ul class="fx-slots">
          {t.notFit.map((n) => <li>{n}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="fx-band fx-band-alt" aria-labelledby="fx-how">
    <div class="fx-wrap">
      <div class="fx-head">
        <h2 id="fx-how">{t.howTitle}</h2>
        <p class="fx-lead">{t.howLead}</p>
      </div>
      <Diagram t={t.diagram} />
      <p class="fx-after">
        <a href={localePath(lang, '/how-it-works/')}>{t.howMore}</a>
      </p>
    </div>
  </section>

  <section class="fx-band" aria-labelledby="fx-cost">
    <div class="fx-wrap fx-split">
      <div class="fx-split-head">
        <h2 id="fx-cost">{t.costTitle}</h2>
        <p class="fx-lead">{t.costLead}</p>
      </div>
      <div class="fx-cost">
        <p class="fx-figure">{t.costReadout}</p>
        <p>{t.costCompare}</p>
        <p>{t.costHidden}</p>
        <a class="fx-more-link" href={localePath(lang, '/costs/')}>{t.costMore}</a>
      </div>
    </div>
  </section>

  <section class="fx-band fx-band-alt" aria-labelledby="fx-open">
    <div class="fx-wrap">
      <h2 id="fx-open">{t.openTitle}</h2>
      <div class="fx-pair">
        {
          [
            { p: t.openSource, href: localePath(lang, '/licenses/') },
            { p: t.hosting, href: localePath(lang, '/self-hosting/') },
          ].map(({ p, href }) => (
            <div>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
              <p class="readout">{p.readout}</p>
              <a class="fx-more-link" href={href}>
                {p.more}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="fx-band fx-band-install" aria-labelledby="fx-install">
    <div class="fx-wrap">
      <div class="fx-plate">
        <div>
          <p class="fx-plate-word" aria-hidden="true">{brand.slug}</p>
          <h2 id="fx-install">{t.installTitle}</h2>
          <p>{t.installText}</p>
          <div class="fx-cmd">
            <code>{installLine}</code>
            <button type="button" class="fx-copy" data-copy={installLine} data-done={t.installCopied}>
              {t.installCopy}
            </button>
          </div>
          <p class="sr-only" aria-live="polite" data-copy-status></p>
        </div>
        <div>
          <ul class="fx-plate-list">
            {t.installRequirements.map((r) => <li>{r}</li>)}
          </ul>
          <a class="fx-plate-link" href={localePath(lang, '/install/')}>{t.installMore}</a>
        </div>
      </div>
    </div>
  </section>

  <footer class="fx-foot">
    <nav class="fx-wrap" aria-labelledby="fx-more">
      <h2 id="fx-more" class="readout">{t.linksTitle}</h2>
      <ul>
        <li><a href={localePath(lang, '/introduction/')}>{t.links.docs}</a></li>
        <li><a href={localePath(lang, '/how-it-works/')}>{t.links.how}</a></li>
        <li><a href={localePath(lang, '/costs/')}>{t.links.costs}</a></li>
        <li><a href={localePath(lang, '/self-hosting/')}>{t.links.selfHosting}</a></li>
        <li><a href={localePath(lang, '/licenses/')}>{t.links.licenses}</a></li>
        <li><a href={brand.repo}>{t.links.github}</a></li>
        <li><a href={localePath(other, '/')} hreflang={other} lang={other}>{t.otherLanguage}</a></li>
      </ul>
      <p class="fx-fine">{t.footer}</p>
    </nav>
  </footer>
</LandingLayout>

<script>
  // Copy the install line; the button says so for a moment, and a live region tells screen
  // readers. Without the Clipboard API the line stays selectable by hand.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const label = button.textContent ?? '';
    const status = document.querySelector<HTMLElement>('[data-copy-status]');
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
      } catch {
        return;
      }
      button.textContent = button.dataset.done ?? label;
      if (status) status.textContent = button.dataset.done ?? '';
      setTimeout(() => {
        button.textContent = label;
        if (status) status.textContent = '';
      }, 1600);
    });
  }
</script>

<style>
  /* Bands: the page tone and the surface tone in turn, split by a hairline. */
  .fx-band {
    padding-block: clamp(3.5rem, 2rem + 5vw, 6.5rem);
    border-top: 1px solid var(--line);
  }
  .fx-band-alt {
    background: var(--surface);
  }

  h2 {
    margin: 0;
    color: var(--ink);
    font-size: clamp(1.75rem, 1.3rem + 1.6vw, 2.6rem);
    font-weight: 800;
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  h3 {
    margin: 0;
    color: var(--ink);
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  p {
    margin: 0;
    line-height: 1.6;
  }
  .fx-lead {
    max-width: 40rem;
    color: var(--ink-2);
    font-size: 1.0625rem;
  }
  .fx-fine {
    max-width: 40rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }
  a:not(.fx-btn) {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--ink-3);
    text-underline-offset: 0.2em;
  }
  a:not(.fx-btn):hover {
    text-decoration-color: currentColor;
  }
  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .fx-more-link {
    display: inline-block;
    margin-top: 0.9rem;
    font-size: 0.9375rem;
  }

  /* Section head: the title, then its lead; side by side on a wide screen. */
  .fx-head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: clamp(2.25rem, 1.5rem + 2.5vw, 3.5rem);
  }
  @media (min-width: 60rem) {
    .fx-head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4rem;
      align-items: start;
    }
    .fx-head .fx-lead {
      padding-top: 0.35rem;
    }
  }
  .fx-after {
    margin-top: 1.75rem;
  }

  /* A head on the left and its content on the right. */
  .fx-split {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 60rem) {
    .fx-split {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 4rem;
    }
    .fx-split-head {
      position: sticky;
      top: 2rem;
      align-self: start;
    }
  }
  .fx-split-head .fx-lead {
    margin-top: 1.25rem;
  }
  .fx-props {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fx-props li {
    padding-block: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .fx-props li:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .fx-props h3 {
    display: flex;
    align-items: baseline;
  }
  .fx-props h3 .slot-mark {
    transform: translateY(-0.2em);
  }
  .fx-props p {
    max-width: 38rem;
    margin-top: 0.6rem;
  }
  .fx-props .readout {
    margin-top: 0.9rem;
  }

  /* Use cases: raised cards, who as a readout under the title. */
  .fx-uses {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(17rem, 100%), 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fx-uses li {
    padding: 1.4rem 1.4rem 1.5rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--raised);
  }
  .fx-uses h3 {
    font-size: 1.0625rem;
  }
  .fx-uses .readout {
    margin-top: 0.4rem;
  }
  .fx-uses p:last-child {
    margin-top: 0.8rem;
    font-size: 0.9375rem;
  }
  .fx-notfit {
    max-width: 44rem;
    margin-top: 3rem;
  }

  /* A list with the slot as marker, 10px from the text, centred on the first line. */
  .fx-slots {
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
  }
  .fx-slots li {
    position: relative;
    padding-inline-start: 22px;
    line-height: 1.6;
  }
  .fx-slots li + li {
    margin-top: 0.55rem;
  }
  .fx-slots li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: calc(0.8em - 2px);
    width: 12px;
    height: 4px;
    border-radius: 2px;
    background: var(--ink-3);
    box-shadow: inset 0 1px 1px rgba(0, 0, 0, 0.3);
  }

  /* Cost: one figure in Departure Mono, then the comparison and the hidden cost. */
  .fx-cost p + p {
    margin-top: 1rem;
  }
  .fx-cost p {
    max-width: 38rem;
  }
  .fx-figure {
    margin-bottom: 1.5rem;
    padding: 1rem 1.25rem;
    border-radius: 10px;
    background: var(--sunken);
    color: var(--ink);
    font-family: var(--f-ro);
    font-size: 1rem;
    line-height: 1.5;
  }

  .fx-pair {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  @media (min-width: 50rem) {
    .fx-pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 4rem;
    }
  }
  .fx-pair p {
    margin-top: 0.75rem;
  }
  .fx-pair .readout {
    margin-top: 1rem;
  }

  /* Install: a panel of the faceplate's dark material, in both themes. */
  .fx-band-install {
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem);
  }
  .fx-plate {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    padding: clamp(1.5rem, 1rem + 3vw, 3rem);
    border: 1px solid var(--plate-edge);
    border-radius: 16px;
    background: linear-gradient(var(--plate-hi), var(--plate-lo));
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.06),
      0 24px 40px -24px rgba(20, 14, 8, 0.45);
    color: #b3aea5;
  }
  @media (min-width: 60rem) {
    .fx-plate {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 4rem;
      align-items: end;
    }
  }
  .fx-plate h2 {
    margin-top: 1.25rem;
    color: #efece5;
  }
  .fx-plate h2 + p {
    max-width: 34rem;
    margin-top: 1rem;
  }
  /* The wordmark as the faceplate prints it; text colours on the plate as in
     design/mark/faceplate.svg, which the tokens do not name. */
  .fx-plate-word {
    color: #8f8b83;
    font-family: var(--f-ui);
    font-size: 0.9375rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .fx-cmd {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 34rem;
    margin-top: 1.75rem;
    padding: 0.4rem 0.4rem 0.4rem 1rem;
    border-radius: 10px;
    background: var(--plate-slot);
    box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.6);
  }
  .fx-cmd code {
    flex: 1;
    min-width: 0;
    overflow-x: auto;
    color: #efece5;
    font-family: var(--f-ro);
    font-size: 0.875rem;
    white-space: nowrap;
  }
  .fx-copy {
    flex: none;
    min-height: 2.25rem;
    padding: 0 0.9rem;
    border: 0;
    border-radius: 7px;
    background: var(--plate-fill);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6), 0 1px 1px rgba(0, 0, 0, 0.5);
    color: var(--plate-lo);
    font: 600 0.875rem/1 var(--f-ui);
    cursor: pointer;
  }
  .fx-copy:hover {
    background: #e6e1d6;
  }
  .fx-plate :focus-visible {
    outline-color: #efece5;
  }
  .fx-plate-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fx-plate-list li {
    position: relative;
    padding-inline-start: 22px;
  }
  .fx-plate-list li + li {
    margin-top: 0.6rem;
  }
  .fx-plate-list li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: calc(0.8em - 2px);
    width: 12px;
    height: 4px;
    border-radius: 2px;
    background: var(--plate-fill);
    opacity: 0.55;
  }
  a.fx-plate-link {
    display: inline-block;
    margin-top: 1.5rem;
    color: #efece5;
    text-decoration-color: #8f8b83;
  }

  .fx-foot {
    padding-block: 3rem 4rem;
    border-top: 1px solid var(--line);
  }
  .fx-foot ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }
  .fx-foot h2 {
    font-size: 11.5px;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--ink-2);
  }
  .fx-foot .fx-fine {
    max-width: none;
    margin-top: 2rem;
  }
</style>
