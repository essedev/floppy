---
// The theme switch of the site's header: a two-position slide switch drawn from the
// faceplate's slot (dark slot, light cap), light on the left and dark on the right, with a
// Departure Mono readout of the position. It is a button with role="switch", on when dark.
// With no stored choice the page follows the system, live; flipping the switch stores the
// choice under Starlight's key ("starlight-theme"), so the landing and the docs agree.
import type { Lang } from '@/brand';
import { chrome } from '@/i18n/chrome';

interface Props {
  /** Language of the page. */
  lang: Lang;
}

const t = chrome[Astro.props.lang];
/** The label id must differ between the header and the docs' mobile menu, on the same page. */
const labelId = `fx-theme-${Math.random().toString(36).slice(2, 8)}`;
---

<fx-theme-switch class="fx-theme">
  <span id={labelId} class="sr-only">{t.themeLabel}</span>
  <button type="button" role="switch" aria-checked="true" aria-labelledby={labelId} class="fx-theme-slot">
    <span class="fx-theme-cap" aria-hidden="true"></span>
  </button>
  <span class="readout fx-theme-ro" aria-hidden="true">
    <span data-ro="light">{t.theme.light}</span>
    <span data-ro="dark">{t.theme.dark}</span>
  </span>
</fx-theme-switch>

{/* Inlined so the switch shows the right position before the first paint. */}
<script is:inline>
  (() => {
    const dark = document.documentElement.dataset.theme !== 'light';
    document.querySelectorAll('fx-theme-switch [role=switch]').forEach((button) => {
      button.setAttribute('aria-checked', String(dark));
    });
  })();
</script>

<script>
  type Theme = 'light' | 'dark';

  /** Starlight's own key, read by its ThemeProvider before the first paint. */
  const storageKey = 'starlight-theme';
  const lightQuery = matchMedia('(prefers-color-scheme: light)');

  /** The stored choice, or null when the reader never flipped the switch. */
  function storedTheme(): Theme | null {
    try {
      const value = localStorage.getItem(storageKey);
      return value === 'light' || value === 'dark' ? value : null;
    } catch {
      return null;
    }
  }

  function storeTheme(theme: Theme): void {
    try {
      localStorage.setItem(storageKey, theme);
    } catch {
      // Storage blocked (private mode): the choice holds for this page only.
    }
  }

  const systemTheme = (): Theme => (lightQuery.matches ? 'light' : 'dark');

  /** Puts the page and every switch on it in the given theme. */
  function showTheme(theme: Theme): void {
    document.documentElement.dataset.theme = theme;
    for (const button of document.querySelectorAll('fx-theme-switch [role=switch]')) {
      button.setAttribute('aria-checked', String(theme === 'dark'));
    }
  }

  // Until the reader chooses, follow the system as it changes.
  lightQuery.addEventListener('change', () => {
    if (!storedTheme()) showTheme(systemTheme());
  });

  class FxThemeSwitch extends HTMLElement {
    constructor() {
      super();
      showTheme(storedTheme() ?? systemTheme());
      this.querySelector('[role=switch]')?.addEventListener('click', () => {
        const next: Theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        storeTheme(next);
        showTheme(next);
      });
    }
  }
  customElements.define('fx-theme-switch', FxThemeSwitch);
</script>

<style>
  .fx-theme {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  /* The faceplate's slot: a dark groove with a light cap, the same in both themes. */
  .fx-theme-slot {
    position: relative;
    flex: none;
    width: 40px;
    height: 20px;
    padding: 0;
    border: 0;
    border-radius: 10px;
    background: var(--plate-slot);
    box-shadow:
      inset 0 1px 2px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(255, 255, 255, 0.09),
      0 1px 0 var(--bezel-lift);
    cursor: pointer;
  }
  .fx-theme-cap {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 14px;
    border-radius: 7px;
    background: var(--plate-fill);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6), 0 1px 1px rgba(0, 0, 0, 0.5);
    transition: transform 0.18s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  .fx-theme-slot[aria-checked='true'] .fx-theme-cap {
    transform: translateX(16px);
  }
  @media (prefers-reduced-motion: reduce) {
    .fx-theme-cap {
      transition: none;
    }
  }
  .fx-theme-slot:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  .fx-theme-ro {
    min-width: 6ch;
    line-height: 1;
  }
  .fx-theme-ro span {
    display: none;
  }
  .fx-theme:has([aria-checked='false']) [data-ro='light'],
  .fx-theme:has([aria-checked='true']) [data-ro='dark'] {
    display: inline;
  }
  .fx-theme:hover .fx-theme-ro {
    color: var(--ink);
  }
</style>
