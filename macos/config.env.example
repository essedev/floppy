# Floppy configuration, copied into the VM. Holds secrets: never commit
# a filled-in copy.
# Empty: install.sh names one volume per Mac. Set it to share a volume, which
# also needs META_URL on PostgreSQL.
VOLUME_NAME=
# Test setup: metadata in the VM. Shared setup: a PostgreSQL URL.
META_URL=sqlite3:///var/lib/floppy/meta.db
BUCKET_URL=https://s3.<region>.io.cloud.ovh.net/<bucket>
ACCESS_KEY=
SECRET_KEY=
# SMB password between the Mac and its own VM: openssl rand -hex 12
SMB_PASSWORD=
# Upper limit for the cache. The real limit is set at every setup to half of
# what the Mac can spare above RESERVE_MB, rounded down to 5 GB, and the agent
# frees the whole cache when the Mac drops under half the reserve.
CACHE_SIZE_MB=102400
RESERVE_MB=20480
CACHE_EXPIRE=720h
# Tuning, defaults in vm/guest/floppy-mount; measured values in docs/ARCHITECTURE.md.
# PREFETCH=8
# BUFFER_SIZE_MB=256
# 0 = no limit. Set only to simulate a slower link.
DOWNLOAD_LIMIT_MBPS=0
UPLOAD_LIMIT_MBPS=0
