#!/usr/bin/python3
"""
What this Mac did on its disks, read from Samba's audit, and each disk's trash (DECISIONS
#27). The activity: folders created, files added, written, replaced, renamed and deleted,
kept 30 days in /var/lib/floppy/activity.db; reads are not recorded. The trash: what
JuiceFS keeps after a delete or a replacement, listed and put back without ever writing
over a file. The app reads both through `floppy activity` and `floppy trash`.

  floppy-activity run                             the service: follows the audit log
  floppy-activity list [--after ID] [--limit N]   JSON out: events newer than ID, the files
                                                  this Mac is writing and those it has open
  floppy-activity trash                           JSON out: every mounted disk's trash
  floppy-activity restore DISK ID...              puts trash entries back, JSON out; DISK
                                                  is "-" for the single-user volume
  floppy-activity rename-back DISK                undoes a rename: {"path", "to"} of the
                                                  event on stdin, JSON out

Samba logs one line per operation (smb.conf: full_audit, its own log file). A few things
in those lines are not what they look like:
- The macOS client keeps a file open about 35 s after the app closed it, so a write is
  done when Samba no longer lists the file as open (smbstatus), not at the last line.
- A save by rename and a Finder "Replace" both arrive as a delete followed by a rename
  or a create on the same name: within SETTLE seconds they become one "replaced".
- Samba 4.22 creates a folder under a temporary name (".::TMPNAME:...") and renames it.
"""

from __future__ import annotations

import ctypes
import errno
import json
import os
import re
import sqlite3
import subprocess
import sys
import time
from calendar import timegm
from contextlib import closing
from dataclasses import dataclass, field
from datetime import datetime
from pathlib import Path

ROOT = "/mnt/drive"
AUDIT = Path("/var/log/samba/audit.log")
DB = Path("/var/lib/floppy/activity.db")
DISKS_JSON = Path("/etc/floppy/team/disks.json")
KEEP_DAYS = 30
# How long a delete waits for the rename or create that makes it a replacement.
SETTLE = 3.0

LINE = re.compile(r"^\[(\d{4})/(\d\d)/(\d\d) (\d\d):(\d\d):(\d\d)\.(\d+),\s*\d+\]\s*(.*)$")
WRITE_ACCESS = 0x2 | 0x4  # FILE_WRITE_DATA, FILE_APPEND_DATA
TMP_FOLDER = ".::TMPNAME:"
# NSDocument's safe save writes "name.sb-<hex>-<id>" next to the file and renames it.
SAFE_SAVE = re.compile(r"\.sb-[0-9a-f]+-\w+$")


def parse(line: str, last_at: float | None) -> tuple[float | None, list[str] | None]:
    """
    One audit line: its time and [op, arg...], or None for anything else. With `debug
    prefix timestamp` the time is on the same line; without, on a header line of its own,
    which only updates the time.
    """
    m = LINE.match(line.rstrip("\n"))
    if m:
        y, mo, d, h, mi, s, frac, msg = m.groups()
        at = time.mktime((int(y), int(mo), int(d), int(h), int(mi), int(s), 0, 0, -1))
        last_at = at + int(frac) / 10 ** len(frac)
        if not msg:
            return last_at, None
    else:
        msg = line.strip()
    parts = msg.split("|", 3)
    if len(parts) < 4 or parts[2] != "ok" or last_at is None:
        return last_at, None
    op, rest = parts[1], parts[3]
    if op == "renameat":
        # Two paths: a name cannot hold "/", so "|" followed by the root starts the second.
        i = rest.find("|" + ROOT + "/")
        if i < 0:
            return last_at, None
        return last_at, [op, rest[:i], rest[i + 1 :]]
    if op == "create_file":
        f = rest.split("|", 3)
        return last_at, [op, *f] if len(f) == 4 else None
    if op in ("unlinkat", "mkdirat"):
        return last_at, [op, rest]
    return last_at, None


@dataclass
class Pending:
    """A file opened for writing, not closed yet."""

    at: float
    op: str  # added, written or replaced


@dataclass
class Tracker:
    """Turns audit operations into events. Paths stay absolute until `place`."""

    drafts: list[dict] = field(default_factory=list)
    pending: dict[str, Pending] = field(default_factory=dict)
    kinds: dict[str, str] = field(default_factory=dict)
    tmp_folders: set[str] = field(default_factory=set)

    def _draft_deleted(self, path: str) -> dict | None:
        for e in reversed(self.drafts):
            if e["op"] == "deleted" and e["path"] == path:
                return e
        return None

    def _rename_prefix(self, src: str, dst: str) -> None:
        for p in [p for p in self.pending if p.startswith(src + "/")]:
            self.pending[dst + p[len(src) :]] = self.pending.pop(p)

    def feed(self, at: float, op: list[str]) -> None:
        name = op[0]
        if name == "create_file":
            mask, kind, disposition, path = op[1:]
            if ":" in path[len(ROOT) :]:
                return  # a stream: Finder info, resource fork
            self.kinds[path] = "folder" if kind == "dir" else "file"
            if kind != "file" or not int(mask, 16) & WRITE_ACCESS or path in self.pending:
                return
            gone = self._draft_deleted(path)
            if gone is not None:
                # Deleted and created again: the Finder's "Replace"
                self.drafts.remove(gone)
                self.pending[path] = Pending(
                    gone.get("was_at", gone["at"]), gone.get("was", "replaced")
                )
            else:
                self.pending[path] = Pending(at, "added" if disposition == "create" else "written")
        elif name == "mkdirat":
            path = op[1]
            if os.path.basename(path).startswith(TMP_FOLDER):
                self.tmp_folders.add(path)
            else:
                self.drafts.append({"at": at, "op": "created", "kind": "folder", "path": path})
        elif name == "unlinkat":
            path = op[1]
            e = {"at": at, "op": "deleted", "kind": self.kinds.pop(path, "file"), "path": path}
            p = self.pending.pop(path, None)
            if p is not None:
                # Written and deleted before closing. If a rename or create puts a file
                # back under the name, it stays what it was (added or written); if not,
                # it was there for a while and both events are kept.
                e["was"], e["was_at"] = p.op, p.at
            self.drafts.append(e)
        elif name == "renameat":
            src, dst = op[1], op[2]
            if src in self.tmp_folders:
                self.tmp_folders.discard(src)
                self.drafts.append({"at": at, "op": "created", "kind": "folder", "path": dst})
                return
            kind = self.kinds.pop(src, "file")
            self.kinds[dst] = kind
            self._rename_prefix(src, dst)
            gone = self._draft_deleted(dst)
            if gone is not None:
                # A save by rename: the old file went to the trash, the new one takes its name
                self.drafts.remove(gone)
                was = gone.get("was", "replaced")
                p = self.pending.pop(src, None)
                at = gone.get("was_at", gone["at"])
                if p is not None:
                    self.pending[dst] = Pending(at, was)
                else:
                    self.drafts = [d for d in self.drafts if d["path"] != src]
                    self.drafts.append({"at": at, "op": was, "kind": "file", "path": dst})
                return
            if src in self.pending:
                self.pending[dst] = self.pending.pop(src)
                if hidden(os.path.basename(src)):
                    return  # a temporary file taking its final name: one "added" at the close
            self.drafts.append({"at": at, "op": "renamed", "kind": kind, "path": src, "to": dst})

    def tick(self, now: float, open_paths) -> list[dict]:
        """Closes the writes Samba no longer holds open; returns the drafts that settled."""
        for path in [p for p in self.pending if p not in open_paths]:
            p = self.pending.pop(path)
            self.drafts.append({"at": p.at, "op": p.op, "kind": "file", "path": path, "done": now})
        ready = []
        for e in [e for e in self.drafts if now - e.get("done", e["at"]) >= SETTLE]:
            if "was" in e:
                ready.append({"at": e["was_at"], "op": e["was"], "kind": "file", "path": e["path"]})
            ready.append(e)
        self.drafts = [e for e in self.drafts if now - e.get("done", e["at"]) < SETTLE]
        # A kind only bridges an open and the delete or rename right after it
        if len(self.kinds) > 10000:
            self.kinds.clear()
        return ready


def hidden(rel: str) -> bool:
    return any(c.startswith(".") or SAFE_SAVE.search(c) for c in rel.split("/"))


def folders() -> dict[str, str] | None:
    """Disk folders to disk ids for the team version; None for the single-user volume."""
    try:
        disks = json.loads(DISKS_JSON.read_text())["disks"]
    except FileNotFoundError:
        return None
    return {d["folder"]: d["id"] for d in disks}


def place(path: str, by_folder: dict[str, str] | None) -> tuple[str | None, str] | None:
    """(disk id, path in the disk) for a path under the share, None outside any disk."""
    if not path.startswith(ROOT + "/"):
        return None
    rel = path[len(ROOT) + 1 :]
    if by_folder is None:
        return None, rel
    folder, _, rest = rel.partition("/")
    if folder not in by_folder or not rest:
        return None
    return by_folder[folder], rest


def to_rows(
    events: list[dict], by_folder: dict[str, str] | None, size, gone_size=lambda _p, _at: None
) -> list[tuple]:
    rows = []
    for e in events:
        where = place(e["path"], by_folder)
        if where is None:
            continue
        op, rel, dest, path = e["op"], where[1], None, e["path"]
        if "to" in e:
            to = place(e["to"], by_folder)
            if to is None or to[0] != where[0] or hidden(to[1]):
                continue  # out of sight, like a file renamed to a hidden name
            if hidden(rel):
                # A hidden file taking a visible name: for whoever looks, it just arrived
                op, rel, path = ("created" if e["kind"] == "folder" else "added"), to[1], e["to"]
            else:
                dest, path = to[1], e["to"]
        elif hidden(rel):
            continue
        if e["kind"] != "file":
            n = None
        elif op == "deleted":
            n = gone_size(path, e["at"])
        else:
            n = size(path)
        rows.append((e["at"], where[0], op, e["kind"], rel, dest, n))
    return rows


def stat_size(path: str) -> int | None:
    try:
        return os.stat(path).st_size
    except OSError:
        return None


class TrashSizes:
    """
    The size of a file just deleted, from the entry its delete made in the disk's trash:
    the file is gone by the time its line is read. Each trash hour is listed once.
    """

    def __init__(self, by_folder: dict[str, str] | None) -> None:
        self.by_folder = by_folder
        self.hours: dict[str, dict[str, list[tuple[float, int]]]] = {}

    def _hour(self, folder: str) -> dict[str, list[tuple[float, int]]]:
        if folder not in self.hours:
            found: dict[str, list[tuple[float, int]]] = {}
            try:
                for d in os.scandir(folder):
                    m = TRASH_NAME.match(d.name)
                    if m and d.is_file(follow_symlinks=False):
                        st = d.stat(follow_symlinks=False)
                        found.setdefault(m[3], []).append((st.st_ctime, st.st_size))
            except OSError:
                pass
            self.hours[folder] = found
        return self.hours[folder]

    def __call__(self, path: str, at: float) -> int | None:
        where = place(path, self.by_folder)
        if where is None:
            return None
        mount = path[: len(path) - len(where[1]) - 1]
        best = None
        # The hour is the delete's, in UTC: either side of a change of hour.
        for t in {int(at - 5) // 3600, int(at + 5) // 3600}:
            hour = time.strftime("%Y-%m-%d-%H", time.gmtime(t * 3600))
            for ctime, size in self._hour(os.path.join(mount, ".trash", hour)).get(
                os.path.basename(path), []
            ):
                if abs(ctime - at) <= 30 and (best is None or abs(ctime - at) < best[0]):
                    best = (abs(ctime - at), size)
        return None if best is None else best[1]


def open_files() -> dict[str, tuple[float, bool]] | None:
    """
    What Samba holds open: absolute path to the time of its oldest open and whether one is
    for writing. None if Samba does not answer.
    """
    out = subprocess.run(
        ["/usr/bin/smbstatus", "-L", "--json"], capture_output=True, text=True, check=False
    )
    if out.returncode != 0:
        return None
    paths: dict[str, tuple[float, bool]] = {}
    for f in json.loads(out.stdout).get("open_files", {}).values():
        for o in f.get("opens", {}).values():
            path = os.path.join(f["service_path"], f["filename"])
            at = datetime.fromisoformat(o["opened_at"]).timestamp()
            write = bool(int(o["access_mask"]["hex"], 16) & WRITE_ACCESS)
            was_at, was_write = paths.get(path, (at, False))
            paths[path] = (min(at, was_at), write or was_write)
    return paths


def open_for_writing() -> dict[str, float] | None:
    """Absolute path to the time of its oldest open, for the files open for writing."""
    opens = open_files()
    if opens is None:
        return None
    return {p: at for p, (at, write) in opens.items() if write}


def writing_rows(pending: dict[str, Pending], by_folder: dict[str, str] | None) -> list[tuple]:
    """The writes still open, as the `writing` table keeps them."""
    rows = []
    for path, p in sorted(pending.items()):
        where = place(path, by_folder)
        if where is not None and not hidden(where[1]):
            rows.append((path, where[0], where[1], p.op, p.at))
    return rows


def connect() -> sqlite3.Connection:
    db = sqlite3.connect(DB, timeout=10)
    db.execute("PRAGMA journal_mode=WAL")
    db.executescript(
        """
        CREATE TABLE IF NOT EXISTS events (
          id INTEGER PRIMARY KEY AUTOINCREMENT, at REAL NOT NULL, disk TEXT, op TEXT NOT NULL,
          kind TEXT NOT NULL, path TEXT NOT NULL, dest TEXT, size INTEGER,
          UNIQUE (at, op, path));
        CREATE TABLE IF NOT EXISTS position (log TEXT PRIMARY KEY, inode INTEGER, offset INTEGER);
        CREATE TABLE IF NOT EXISTS writing (
          abs TEXT PRIMARY KEY, disk TEXT, path TEXT NOT NULL, op TEXT NOT NULL,
          since REAL NOT NULL);
        """
    )
    # Ids start at the time of creation in milliseconds and never go back: the app and
    # the control plane know an event by its id, and a VM made again must not reuse one.
    with db:
        db.execute(
            "INSERT INTO sqlite_sequence (name, seq) SELECT 'events', ?"
            " WHERE NOT EXISTS (SELECT 1 FROM sqlite_sequence WHERE name = 'events')",
            (int(time.time() * 1000),),
        )
    return db


class Follower:
    """Reads the audit log across Samba's rotation (audit.log to audit.log.old)."""

    def __init__(self, inode: int | None, offset: int) -> None:
        self.f = None
        old = Path(str(AUDIT) + ".old")
        for p in (old, AUDIT):
            try:
                if os.stat(p).st_ino == inode:
                    self.f = open(p, "rb")  # noqa: SIM115 (held across reads)
                    self.f.seek(offset)
                    break
            except FileNotFoundError:
                pass
        if self.f is None:
            self.f = self._open()

    def _open(self):
        while True:
            try:
                return open(AUDIT, "rb")
            except FileNotFoundError:
                time.sleep(1)

    def lines(self) -> list[str]:
        out = []
        while True:
            line = self.f.readline()
            if line.endswith(b"\n"):
                out.append(line.decode("utf-8", "replace"))
                continue
            if line:
                self.f.seek(-len(line), os.SEEK_CUR)  # half a line: read it next time
            try:
                rotated = os.stat(AUDIT).st_ino != os.fstat(self.f.fileno()).st_ino
            except FileNotFoundError:
                rotated = False
            if not rotated:
                return out
            self.f.close()
            self.f = self._open()

    def close(self) -> None:
        self.f.close()

    def position(self) -> tuple[int, int]:
        return os.fstat(self.f.fileno()).st_ino, self.f.tell()


def run() -> None:
    db = connect()
    row = db.execute("SELECT inode, offset FROM position WHERE log = 'audit'").fetchone()
    follower = Follower(*(row or (None, 0)))
    tracker, last_at, last_trim = Tracker(), None, 0.0
    saved, saved_writing = follower.position(), []
    # Writes open before a restart are not tracked: none is in progress as far as we know.
    with db:
        db.execute("DELETE FROM writing")
    while True:
        for line in follower.lines():
            last_at, op = parse(line, last_at)
            if op is not None:
                tracker.feed(last_at, op)
        now = time.time()
        opens = open_for_writing() if tracker.pending else {}
        if opens is None:
            opens = tracker.pending  # Samba down: no write counts as done
        by_folder = folders()
        rows = to_rows(tracker.tick(now, opens), by_folder, stat_size, TrashSizes(by_folder))
        writing = writing_rows(tracker.pending, by_folder)
        position, trim = follower.position(), now - last_trim > 3600
        if rows or position != saved or trim or writing != saved_writing:
            with db:
                db.executemany(
                    "INSERT OR IGNORE INTO events (at, disk, op, kind, path, dest, size)"
                    " VALUES (?, ?, ?, ?, ?, ?, ?)",
                    rows,
                )
                if writing != saved_writing:
                    db.execute("DELETE FROM writing")
                    db.executemany("INSERT INTO writing VALUES (?, ?, ?, ?, ?)", writing)
                # Lines behind writes still open or drafts still settling are lost if the
                # service stops now: the cost of not replaying the log into duplicates.
                db.execute("INSERT OR REPLACE INTO position VALUES ('audit', ?, ?)", position)
                if trim:
                    db.execute("DELETE FROM events WHERE at < ?", (now - KEEP_DAYS * 86400,))
                    last_trim = now
            saved, saved_writing = position, writing
        time.sleep(1)


def list_events(after: int, limit: int) -> dict:
    with closing(connect()) as db:
        rows = db.execute(
            "SELECT id, at, disk, op, kind, path, dest, size FROM events WHERE id > ?"
            " ORDER BY id LIMIT ?",
            (after, limit),
        ).fetchall()
    keys = ("id", "at", "disk", "op", "kind", "path", "to", "size")
    events = [
        {k: v for k, v in zip(keys, r, strict=True) if v is not None or k == "disk"} for r in rows
    ]
    return {"events": events, "last": rows[-1][0] if rows else after}


def list_writing() -> list[dict]:
    """The files this Mac is writing now, with their size so far."""
    with closing(connect()) as db:
        rows = db.execute("SELECT abs, disk, path, op, since FROM writing ORDER BY abs").fetchall()
    return [
        {"disk": disk, "path": path, "op": op, "since": since, "size": stat_size(a)}
        for a, disk, path, op, since in rows
    ]


def list_open() -> list[dict]:
    """
    The files this Mac has open, read or written. Only the app sees them, to warn when one is
    a colleague's file still arriving; they are never recorded (DECISIONS #27).
    """
    by_folder, out = folders(), []
    for path in sorted(open_files() or {}):
        where = place(path, by_folder)
        if where is not None and not hidden(where[1]):
            out.append({"disk": where[0], "path": where[1]})
    return out


# The trash. JuiceFS moves a deleted or replaced entry to <mount>/.trash/<hour>/, the hour
# of the delete in UTC, named "<parent inode>-<inode>-<name>", and drops whole hours once
# they are older than the volume's trash days. A folder deleted with its files is one entry
# per file and folder, each under the inode of its own parent.
TRASH_HOUR = re.compile(r"^(\d{4})-(\d\d)-(\d\d)-(\d\d)$")
TRASH_NAME = re.compile(r"^(\d+)-(\d+)-(.+)$", re.S)
TRASH_ID = re.compile(r"^(\d{4}-\d\d-\d\d-\d\d)/(\d+)-(\d+)$")
RESTORED = "ripristinato"  # in the file's name, which the Italian Finder shows


@dataclass
class TrashEntry:
    """One entry of a disk's trash."""

    id: str  # "<hour>/<parent>-<inode>": no name, so it can travel on a command line
    name: str
    parent: int
    ino: int
    folder: bool
    deleted_at: float
    size: int
    path: str  # in .trash


@dataclass
class Mount:
    """A disk as this VM mounts it."""

    disk: str | None  # None for the single-user volume
    folder: str | None
    path: str
    writable: bool


def mounts() -> list[Mount]:
    """The mounted disks: the team's from the disks file, or the single-user volume."""
    options = {}
    with open("/proc/mounts") as f:
        for line in f:
            parts = line.split()
            options[parts[1].replace("\\040", " ")] = parts[3].split(",")
    by_folder = folders()
    if by_folder is None:
        found = [(None, None, ROOT)]
    else:
        found = [(disk, folder, f"{ROOT}/{folder}") for folder, disk in by_folder.items()]
    return [
        Mount(disk, folder, path, "ro" not in options[path])
        for disk, folder, path in found
        if path in options
    ]


def scan_trash(mount: str) -> list[TrashEntry]:
    entries = []
    trash = os.path.join(mount, ".trash")
    for hour in sorted(os.listdir(trash)):
        if not TRASH_HOUR.match(hour):
            continue
        for d in os.scandir(os.path.join(trash, hour)):
            m = TRASH_NAME.match(d.name)
            if not m:
                continue
            st = d.stat(follow_symlinks=False)
            entries.append(
                TrashEntry(
                    id=f"{hour}/{m[1]}-{m[2]}",
                    name=m[3],
                    parent=int(m[1]),
                    ino=int(m[2]),
                    folder=d.is_dir(follow_symlinks=False),
                    deleted_at=st.st_ctime,
                    size=0 if d.is_dir(follow_symlinks=False) else st.st_size,
                    path=d.path,
                )
            )
    return entries


def inode_path(mount: str, ino: int) -> str | None:
    """
    Where an inode is now, relative to the disk ("" for its top), through the mount's
    `juicefs info`; None when it is gone or in the trash itself. One inode per call: an
    unknown one ends the command.
    """
    if ino == 1:
        return ""
    out = subprocess.run(  # noqa: S603 (a fixed binary and an integer)
        ["/usr/local/bin/juicefs", "info", "-i", str(ino)],
        cwd=mount,
        capture_output=True,
        text=True,
        check=False,
    )
    for line in out.stdout.splitlines():
        key, _, value = line.strip().partition(": ")
        if key == "path" and value.startswith("/") and not value.startswith("/.trash/"):
            return value[1:]
    return None


def trash_days(mount: str) -> int:
    """The volume's trash days, from JuiceFS's virtual .config file."""
    try:
        conf = json.loads(Path(mount, ".config").read_text())
    except (OSError, ValueError):
        return 0
    stack = [conf]
    while stack:
        node = stack.pop()
        if isinstance(node, dict):
            if isinstance(node.get("TrashDays"), int):
                return node["TrashDays"]
            stack.extend(node.values())
    return 0


def hour_start(entry_id: str) -> float:
    y, mo, d, h = TRASH_HOUR.match(entry_id.partition("/")[0]).groups()
    return float(timegm((int(y), int(mo), int(d), int(h), 0, 0)))


def deleted_here(disk: str | None, path: str, at: float) -> bool:
    """Whether this Mac's activity has the delete or replacement of `path` around `at`."""
    try:
        with closing(connect()) as db:
            row = db.execute(
                "SELECT 1 FROM events WHERE disk IS ? AND path = ?"
                " AND op IN ('deleted', 'replaced') AND at BETWEEN ? AND ? LIMIT 1",
                (disk, path, at - 120, at + 120),
            ).fetchone()
    except sqlite3.Error:
        return False
    return row is not None


def list_trash(m: Mount, entries: list[TrashEntry], where=inode_path, here=deleted_here) -> dict:
    """
    One disk's trash as the app shows it: a deleted folder is one entry with its files
    counted inside. An entry whose name is taken again where it was is a replaced version.
    """
    days = trash_days(m.path)
    by_ino = {e.ino: e for e in entries}
    kids: dict[int, list[TrashEntry]] = {}
    for e in entries:
        kids.setdefault(e.parent, []).append(e)

    def tree(e: TrashEntry) -> tuple[int, int]:
        files, size = 0, 0
        for k in kids.get(e.ino, []):
            if k.folder:
                f, s = tree(k)
                files, size = files + f, size + s
            else:
                files, size = files + 1, size + k.size
        return files, size

    parents: dict[int, str | None] = {}
    out = []
    for e in sorted(entries, key=lambda e: e.deleted_at, reverse=True):
        if e.parent in by_ino:
            continue  # inside a deleted folder
        if e.parent not in parents:
            parents[e.parent] = where(m.path, e.parent)
        origin = parents[e.parent]
        rel = None if origin is None else os.path.join(origin, e.name)
        item = {
            "id": e.id,
            "name": e.name,
            "kind": "folder" if e.folder else "file",
            "from": origin,
            "deleted_at": e.deleted_at,
            "expires_at": hour_start(e.id) + days * 86400,
            "size": e.size,
            "replaced": not e.folder
            and rel is not None
            and os.path.lexists(os.path.join(m.path, rel)),
            "by_this_mac": rel is not None and here(m.disk, rel, e.deleted_at),
        }
        if e.folder:
            item["files"], item["size"] = tree(e)
        out.append(item)
    return {
        "disk": m.disk,
        "folder": m.folder,
        "writable": m.writable,
        "trash_days": days,
        "entries": out,
    }


def rename_noreplace(src: str, dst: str) -> None:
    """rename(2) that fails with FileExistsError instead of replacing `dst`."""
    libc = ctypes.CDLL(None, use_errno=True)
    at_fdcwd, rename_noreplace_flag = -100, 1
    if libc.renameat2(
        at_fdcwd, os.fsencode(src), at_fdcwd, os.fsencode(dst), rename_noreplace_flag
    ):
        e = ctypes.get_errno()
        raise OSError(e, os.strerror(e), dst)


def free_name(name: str, n: int) -> str:
    """The n-th name to try: the name, then "name (ripristinato).ext", "... 2", ..."""
    if n == 0:
        return name
    stem, dot, ext = name.rpartition(".")
    if not stem:
        stem, dot, ext = name, "", ""
    tag = RESTORED if n == 1 else f"{RESTORED} {n}"
    return f"{stem} ({tag}){dot}{ext}"


def put_back(src: str, folder: str, name: str, move=rename_noreplace) -> str:
    """Moves `src` into `folder` under the first free name; returns the name used."""
    for n in range(100):
        candidate = free_name(name, n)
        try:
            move(src, os.path.join(folder, candidate))
            return candidate
        except FileExistsError:
            continue
    raise FileExistsError(errno.EEXIST, "no free name", os.path.join(folder, name))


def restore(
    m: Mount, entry_id: str, entries: list[TrashEntry], where=inode_path, move=rename_noreplace
) -> dict:
    """
    Puts one entry back where it was, or at the top of the disk when that folder is gone,
    under a free name; a folder comes back with everything deleted inside it.
    """
    if not m.writable:
        raise PermissionError(errno.EROFS, "the disk is read-only on this Mac", m.path)
    entry = next((e for e in entries if e.id == entry_id), None)
    if entry is None:
        raise FileNotFoundError(errno.ENOENT, "not in the trash", entry_id)
    origin = where(m.path, entry.parent)
    folder = os.path.join(m.path, origin or "")
    name = put_back(entry.path, folder, entry.name, move)
    kids: dict[int, list[TrashEntry]] = {}
    for e in entries:
        kids.setdefault(e.parent, []).append(e)
    # The folder keeps its inode out of the trash: its files follow it under their names.
    stack = [(entry.ino, os.path.join(folder, name))]
    while stack:
        ino, into = stack.pop()
        for k in kids.get(ino, []):
            used = put_back(k.path, into, k.name, move)
            if k.folder:
                stack.append((k.ino, os.path.join(into, used)))
    rel = os.path.join(origin or "", name)
    return {
        "id": entry_id,
        "disk": m.disk,
        "path": rel,
        "name": name,
        "renamed": name != entry.name,
        "moved": origin is None,
    }


def restore_many(
    m: Mount, ids: list[str], entries: list[TrashEntry], where=inode_path, move=rename_noreplace
) -> dict:
    """Puts several entries back; one that fails does not stop the others."""
    if not m.writable:
        raise PermissionError(errno.EROFS, "the disk is read-only on this Mac", m.path)
    restored, failed = [], []
    for entry_id in ids:
        try:
            restored.append(restore(m, entry_id, entries, where, move))
        except OSError as e:
            failed.append({"id": entry_id, "error": e.strerror or str(e)})
    return {"restored": restored, "failed": failed}


def inside(rel: object) -> str | None:
    """A path in a disk as an event names it, or None for one that leaves the disk."""
    if not isinstance(rel, str) or not rel or rel.startswith("/") or "\0" in rel:
        return None
    parts = rel.split("/")
    if any(p in ("", ".", "..") for p in parts):
        return None
    return rel


def rename_back(m: Mount, path: str, to: str, move=rename_noreplace) -> dict:
    """
    Undoes the rename of `path` to `to`: `to` takes its name of before again, never over
    what holds that name now. `reason` says why not: gone (nothing at `to`), taken (the old
    name is in use) or no_folder (the folder it was in is gone).
    """
    if not m.writable:
        raise PermissionError(errno.EROFS, "the disk is read-only on this Mac", m.path)
    src, dst = os.path.join(m.path, to), os.path.join(m.path, path)
    reason = None
    if not os.path.lexists(src):
        reason = "gone"
    elif not os.path.isdir(os.path.dirname(dst)):
        reason = "no_folder"
    else:
        try:
            move(src, dst)
        except FileExistsError:
            reason = "taken"
        except FileNotFoundError:
            reason = "gone"
    return {"disk": m.disk, "path": path, "to": to, "done": reason is None, "reason": reason}


def main(argv: list[str]) -> int:
    cmd, args = (argv[0] if argv else ""), argv[1:]
    if cmd == "run" and not args:
        run()
    elif cmd == "list":
        opts = dict(zip(args[::2], args[1::2], strict=False))
        if (
            len(args) % 2
            or set(opts) - {"--after", "--limit"}
            or not all(v.isdigit() for v in opts.values())
        ):
            print("usage: floppy-activity list [--after ID] [--limit N]", file=sys.stderr)
            return 2
        out = list_events(int(opts.get("--after", 0)), int(opts.get("--limit", 1000)))
        print(json.dumps({**out, "writing": list_writing(), "open": list_open()}))
    elif cmd == "trash" and not args:
        print(json.dumps({"disks": [list_trash(m, scan_trash(m.path)) for m in mounts()]}))
    elif cmd == "restore" and len(args) >= 2 and all(TRASH_ID.match(a) for a in args[1:]):
        m = mounted(args[0])
        if m is None:
            return 1
        try:
            out = restore_many(m, args[1:], scan_trash(m.path))
            for r in out["restored"]:
                notify("added", os.path.join(m.path, r["path"]))
            print(json.dumps(out))
        except OSError as e:
            print(f"floppy-activity: {e.strerror}", file=sys.stderr)
            return 1
    elif cmd == "rename-back" and len(args) == 1:
        try:
            body = json.loads(sys.stdin.read(65536))
        except ValueError:
            body = None
        path = inside(body.get("path")) if isinstance(body, dict) else None
        to = inside(body.get("to")) if isinstance(body, dict) else None
        if path is None or to is None or hidden(path) or hidden(to):
            print('floppy-activity: rename-back wants {"path", "to"} in the disk', file=sys.stderr)
            return 2
        m = mounted(args[0])
        if m is None:
            return 1
        try:
            out = rename_back(m, path, to)
            if out["done"]:
                notify("removed", os.path.join(m.path, to))
                notify("added", os.path.join(m.path, path))
                record_rename(m.disk, to, path, os.path.join(m.path, path))
            print(json.dumps(out))
        except OSError as e:
            print(f"floppy-activity: {e.strerror}", file=sys.stderr)
            return 1
    else:
        print(
            "usage: floppy-activity run|list [--after ID] [--limit N]|trash"
            "|restore DISK ID...|rename-back DISK",
            file=sys.stderr,
        )
        return 2
    return 0


def record_rename(disk: str | None, src: str, dst: str, now_at: str) -> None:
    """
    A rename made here, outside Samba, as the audit would have recorded it: the colleague
    whose rename was undone learns it from this event (DECISIONS #27).
    """
    kind = "folder" if os.path.isdir(now_at) else "file"
    with closing(connect()) as db, db:
        db.execute(
            "INSERT OR IGNORE INTO events (at, disk, op, kind, path, dest, size)"
            " VALUES (?, ?, 'renamed', ?, ?, ?, NULL)",
            (time.time(), disk, kind, src, dst),
        )


def notify(action: str, path: str) -> None:
    """
    Tells the Finder of a change made here, outside Samba: with `kernel change notify = no`
    Samba no longer sees them by itself (floppy-notify). A failure only delays the window.
    """
    subprocess.run(  # noqa: S603 (a fixed binary; the path is passed as one argument)
        ["/usr/local/sbin/floppy-notify", "trigger", action, path],
        capture_output=True,
        check=False,
    )


def mounted(disk_arg: str) -> Mount | None:
    """The mount of a disk named on the command line, "-" for the single-user volume."""
    disk = None if disk_arg == "-" else disk_arg
    m = next((m for m in mounts() if m.disk == disk), None)
    if m is None:
        print(f"floppy-activity: disk {disk_arg} is not mounted", file=sys.stderr)
    return m


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
