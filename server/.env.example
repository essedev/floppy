# Copy to server/.env (outside git) and fill in. Generate secrets with:
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"

# development | test | production. Production refuses the console mail and the fake Valkey.
FLOPPY_ENV=development

# Encryption of stored secrets and the key for 6-digit codes: 32 random bytes, base64.
# Losing it is recoverable (DATABASE_SCHEMA.md, "Secrets"), but keep it out of the database.
FLOPPY_SECRET_KEY=

# PostgreSQL roles: the owner runs migrations, the application has no DELETE.
FLOPPY_DB_OWNER_PASSWORD=
FLOPPY_DB_APP_PASSWORD=
# For `uv run` from the host (Compose sets these for the server container):
FLOPPY_DATABASE_URL=postgresql+asyncpg://floppy_app:CHANGE_ME@127.0.0.1:4504/floppy
FLOPPY_MIGRATION_DATABASE_URL=postgresql+asyncpg://floppy_owner:CHANGE_ME@127.0.0.1:4504/floppy

# The central Valkey's admin password (the `default` user).
FLOPPY_VALKEY_ADMIN_PASSWORD=

# The admin web's address: links in mail point here. Plain http in development needs
# FLOPPY_COOKIE_SECURE=false.
FLOPPY_PUBLIC_URL=http://localhost:4508
FLOPPY_COOKIE_SECURE=false

# Mail: console prints links and codes (development only); smtp sends.
FLOPPY_MAIL_BACKEND=console
# FLOPPY_SMTP_HOST=
# FLOPPY_SMTP_PORT=587
# FLOPPY_SMTP_USERNAME=
# FLOPPY_SMTP_PASSWORD=
# FLOPPY_SMTP_SENDER="Floppy <floppy@example.com>"

# Phase 1: JuiceFS and the S3 probe are fakes; Valkey is real.
FLOPPY_METADATA_BACKEND=real
FLOPPY_JUICEFS_BACKEND=fake
FLOPPY_STORAGE_BACKEND=fake

# The first organization, created by `floppy-server bootstrap --from-env` at first start.
FLOPPY_BOOTSTRAP_ORGANIZATION_NAME="Studio Esempio"
FLOPPY_BOOTSTRAP_ORGANIZATION_SLUG=studio-esempio
FLOPPY_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
FLOPPY_BOOTSTRAP_S3_ENDPOINT=https://s3.eu-south.io.cloud.ovh.net
FLOPPY_BOOTSTRAP_S3_REGION=eu-south
FLOPPY_BOOTSTRAP_S3_BUCKET=floppy-studio
FLOPPY_BOOTSTRAP_S3_ACCESS_KEY_ID=
FLOPPY_BOOTSTRAP_S3_SECRET_KEY=
# The Valkey address Macs use, and how the control plane reaches the same instance.
FLOPPY_BOOTSTRAP_VALKEY_URL=redis://localhost:4505
FLOPPY_BOOTSTRAP_VALKEY_ADMIN_URL=redis://127.0.0.1:4505
