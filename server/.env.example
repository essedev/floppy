# Copy to server/.env (outside git) and fill in. Generate secrets with:
#   python3 -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"

# development | test | production. Production refuses the console mail and the fake Valkey.
FLOPPY_ENV=development

# Encryption of stored secrets and the key for 6-digit codes: 32 random bytes, base64.
# Losing it is recoverable (DATABASE_SCHEMA.md, "Secrets"), but keep it out of the database.
FLOPPY_SECRET_KEY=

# PostgreSQL roles: the owner runs migrations, the application has no DELETE.
FLOPPY_DB_OWNER_PASSWORD=
FLOPPY_DB_APP_PASSWORD=
# For `uv run` from the host (Compose sets these for the server container):
FLOPPY_DATABASE_URL=postgresql+asyncpg://floppy_app:CHANGE_ME@127.0.0.1:4504/floppy
FLOPPY_MIGRATION_DATABASE_URL=postgresql+asyncpg://floppy_owner:CHANGE_ME@127.0.0.1:4504/floppy

# The admin password (the `default` user) of the meta pool's Valkey instances, one per disk.
FLOPPY_VALKEY_ADMIN_PASSWORD=
# The meta service (DECISIONS #25): `pool` hands each new disk one instance of FLOPPY_META_POOL
# (comma-separated `url` as devices reach it, `|admin_url` as the control plane does);
# `fake` invents them (development only). Compose sets the pool for the server container; for
# `uv run` from the host:
FLOPPY_META_BACKEND=pool
FLOPPY_META_POOL=redis://localhost:4541,redis://localhost:4542,redis://localhost:4543

# The admin web's address: links in mail point here. Plain http in development needs
# FLOPPY_COOKIE_SECURE=false.
FLOPPY_PUBLIC_URL=http://localhost:4508
FLOPPY_COOKIE_SECURE=false

# Mail: console prints links and codes (development only); smtp sends.
FLOPPY_MAIL_BACKEND=console
# FLOPPY_SMTP_HOST=
# FLOPPY_SMTP_PORT=587
# FLOPPY_SMTP_USERNAME=
# FLOPPY_SMTP_PASSWORD=
# FLOPPY_SMTP_SENDER="Floppy <floppy@example.com>"

# real (the default) or fake, for development without a bucket: a fake JuiceFS records disks
# without formatting them, a fake probe accepts any key without DENIED in it.
FLOPPY_METADATA_BACKEND=real
FLOPPY_JUICEFS_BACKEND=fake
FLOPPY_STORAGE_BACKEND=fake
# Where the image's build finds the patched JuiceFS (spike/juicefs-replica/build.sh).
# JUICEFS_DIST=../spike/juicefs-replica/dist

# The first organization, created by `floppy-server bootstrap --from-env` at first start.
# The endpoint and region are the defaults of new disks; each disk has its own bucket.
FLOPPY_BOOTSTRAP_ORGANIZATION_NAME="Studio Esempio"
FLOPPY_BOOTSTRAP_ORGANIZATION_SLUG=studio-esempio
FLOPPY_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
FLOPPY_BOOTSTRAP_S3_ENDPOINT=https://s3.eu-south.io.cloud.ovh.net
FLOPPY_BOOTSTRAP_S3_REGION=eu-south
# Mail language of the organization (it or en), set at creation and changed in Settings.
FLOPPY_BOOTSTRAP_MAIL_LANGUAGE=it
# Storage (DATABASE_SCHEMA.md, "Storage modes"): manual (the admin pastes a bucket and a key
# with each disk) or managed (a provider adapter creates each disk's bucket and a key per
# device). Managed admin credentials come from FLOPPY_BOOTSTRAP_STORAGE_ADMIN_CREDENTIALS
# (JSON) or the instance's FLOPPY_GARAGE_ADMIN_*.
FLOPPY_BOOTSTRAP_STORAGE_MODE=manual
# FLOPPY_BOOTSTRAP_STORAGE_PROVIDER=garage
# FLOPPY_BOOTSTRAP_STORAGE_ADMIN_CREDENTIALS={"adminUrl": "http://garage:3903", "adminToken": "..."}
# FLOPPY_GARAGE_ADMIN_URL=http://garage:3903
# FLOPPY_GARAGE_ADMIN_TOKEN=

# Addresses of the reverse proxies whose X-Forwarded-For is believed (comma-separated);
# the rate limits count the client address it gives.
# FLOPPY_TRUSTED_PROXIES=127.0.0.1

# Written by docker/garage-setup.sh for the integration tests: FLOPPY_GARAGE_RPC_SECRET and
# FLOPPY_TEST_S3_* (a bucket, two keys allowed on it, one refused). A Garage elsewhere than the
# Compose ports: FLOPPY_TEST_S3_URL and FLOPPY_TEST_GARAGE_ADMIN_URL. The tests' database
# (recreated at every run) is FLOPPY_TEST_DB_NAME, floppy_test by default.
