{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Floppy",
  "version": "0.1.1",
  "identifier": "dev.esse.floppy.menubar",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "panel",
        "title": "Floppy",
        "width": 352,
        "height": 420,
        "decorations": false,
        "transparent": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": false
      },
      {
        "label": "settings",
        "title": "Impostazioni",
        "width": 600,
        "height": 700,
        "minWidth": 480,
        "minHeight": 420,
        "visible": false,
        "center": true
      },
      {
        "label": "welcome",
        "title": "Floppy",
        "width": 440,
        "height": 640,
        "visible": false,
        "resizable": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "copyright": "Simone Salerno, MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
