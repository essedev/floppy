+// follow points the replica at addr and waits for the link to be up.
+func (e *replicaEnv) follow(t *testing.T, addr string) {
+	ctx := context.Background()
+	host, port, _ := net.SplitHostPort(addr)
+	if err := e.rcli.Do(ctx, "REPLICAOF", host, port).Err(); err != nil {
+		t.Fatalf("replicaof %s: %s", addr, err)
+	}
+	for i := 0; i < 200; i++ {
+		info, err := e.rcli.Info(ctx, "replication").Result()
+		if err == nil && strings.Contains(info, "master_link_status:up") {
+			return
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+	t.Fatalf("replica did not connect to %s", addr)
+}
+
+// replicaCalls is how many times the replica ran the given commands.
+func (e *replicaEnv) replicaCalls(t *testing.T, cmds ...string) int64 {
+	info, err := e.rcli.Info(context.Background(), "commandstats").Result()
+	if err != nil {
+		t.Fatalf("info commandstats: %s", err)
+	}
+	var total int64
+	for _, line := range strings.Split(info, "\n") {
+		for _, cmd := range cmds {
+			if v, ok := strings.CutPrefix(line, "cmdstat_"+cmd+":calls="); ok {
+				n, _ := strconv.ParseInt(v[:strings.IndexByte(v, ',')], 10, 64)
+				total += n
+			}
+		}
+	}
+	return total
+}
