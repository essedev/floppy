+package meta
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"math/rand"
+	"net"
+	"net/url"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+
+	"github.com/prometheus/client_golang/prometheus"
+	"github.com/redis/go-redis/v9"
+)
+
+/*
+	Read replica: a Redis replica, usually on the client's machine, that serves the reads made
+	outside transactions, while writes and the reads inside transactions stay on the master.
+
+	  redis://:pass@master:6379/1?read-replica=redis://127.0.0.1:6380&max-lag=2s&master-timeout=10s
+
+	The replica URL takes the master's database and password when it has none.
+
+	Read-your-writes: every MULTI/EXEC sent to the master also runs HINCRBY ryw$sid <random field>
+	in the same round trip, and the client remembers the highest value returned. A read goes to the
+	replica only once the replica holds that value (remembered too, so it costs an HGET on the
+	replica only right after a write); otherwise it waits up to one master round trip and then goes
+	to the master. Writes made before the session (format) are ordered before the session's own
+	transaction, which is tracked.
+	Transactions read from the replica too and commit in one round trip (redis_optimistic.go).
+
+	Freshness: every min(500ms, max-lag/4) a probe reads master_repl_offset on the master and the
+	check loop reads it on the replica. A sample is dated at half the probe's round trip, since a
+	read from the master would not be fresher; the replica holds every write committed before the
+	newest sample it has reached. When that is older than max-lag, or the replication link is
+	down, reads go to the master.
+
+	Offline, when the master is unreachable while the replica answers with the master's replication
+	id (a replica restarted empty or promoted is never served):
+	- at once when connecting to the master is refused, has no route, or its name does not resolve;
+	- after master-timeout (default 10s) without a single byte from the master on any connection,
+	  while the probe asks every 500ms. A slow master is not an outage: timeouts alone never make a
+	  command go offline, and a saturated uplink only makes writes slow.
+	Going offline closes the connections to the master, so the commands waiting for it fail with
+	EROFS at once; from then on every command to the master fails with EROFS without being sent,
+	reads go to the replica however stale, and the first answer to the probe ends it. Otherwise a
+	command waits for the master up to twice master-timeout and fails with the usual error.
+
+	The mode is logged on every change and exported as the gauges meta_replica_mode (-1 not checked
+	yet, 0 master, 1 replica, 2 offline) and meta_replica_lag_seconds.
+*/
+
+const (
+	replicaModeUnknown int32 = iota - 1 // before the first check, reads go to the master
+	replicaModeMaster                   // reads go to the master
+	replicaModeReplica                  // reads go to the replica, it is fresh
+	replicaModeOffline                  // the master is unreachable, reads go to the stale replica
+)
+
+var replicaModeNames = []string{"master", "replica", "offline"}
+
+func replicaModeName(mode int32) string {
+	if mode == replicaModeUnknown {
+		return "start"
+	}
+	return replicaModeNames[mode]
+}
+
+type replicaSample struct {
+	at     int64 // unix nanos, when the master answered (half its round trip)
+	offset int64
+}
+
+type redisReplica struct {
+	m        *redisMeta
+	cli      *redis.Client
+	probe    *redis.Client // to the master, without retries, for the probe loop only
+	addr     string
+	maxLag   time.Duration
+	timeout  time.Duration // the silence of the master that means offline
+	interval time.Duration
+
+	key        atomic.Value // rywKey, the read-your-writes counter of the session
+	required   atomic.Int64 // highest read-your-writes value returned by the master
+	reached    atomic.Int64 // highest read-your-writes value seen on the replica
+	freshAt    atomic.Int64 // unix nanos: the replica holds every write committed before it
+	rtt        atomic.Int64 // last round trip of the probe, in nanos
+	lastAnswer atomic.Int64 // unix nanos of the last answer of the master, to any command
+	mode       atomic.Int32
+	modeMu     sync.Mutex
+	offline    atomic.Pointer[offlineSignal]
+	conns      sync.Map // *masterConn: the open connections to the master
+
+	servable  atomic.Bool  // the replica answered the last check with the master's replication id
+	conflicts atomic.Int64 // optimistic transactions that ran again with WATCH after a conflict
+	fallbacks atomic.Int64 // optimistic transactions that could not run optimistically
+
+	mu        sync.Mutex // guards the master state below, written by the probe loop
+	samples   []replicaSample
+	replid    string // replication id of the master
+	masterErr error  // result of the last probe
+
+	modeG prometheus.Gauge
+	lagG  prometheus.Gauge
+	done  chan struct{} // closed to stop the loops
+	wg    sync.WaitGroup
+	once  sync.Once
+}
+
+// offlineSignal is cancelled when the client goes offline, to stop commands waiting for the master.
+type offlineSignal struct {
+	ctx    context.Context
+	cancel context.CancelFunc
+	since  atomic.Int64 // unix nanos, when offline started
+}
+
+func newOfflineSignal() *offlineSignal {
+	ctx, cancel := context.WithCancel(context.Background())
+	return &offlineSignal{ctx: ctx, cancel: cancel}
+}
+
+func newRedisReplica(m *redisMeta, uri string, master *redis.Options, maxLag, masterTimeout time.Duration) (*redisReplica, error) {
+	if _, ok := m.rdb.(*redis.Client); !ok {
+		return nil, fmt.Errorf("read-replica needs a single Redis master, not Sentinel or Cluster")
+	}
+	if maxLag <= 0 || masterTimeout <= 0 {
+		return nil, fmt.Errorf("max-lag (%s) and master-timeout (%s) must be positive", maxLag, masterTimeout)
+	}
+	opt, err := redis.ParseURL(uri)
+	if err != nil {
+		return nil, fmt.Errorf("redis parse read-replica: %s", err)
+	}
+	if u, err := url.Parse(uri); err == nil && u.Scheme != "unix" && strings.Trim(u.Path, "/") == "" {
+		opt.DB = master.DB // no database in the URL: use the master's
+	}
+	if opt.DB != master.DB {
+		return nil, fmt.Errorf("read-replica uses database %d but the master uses %d", opt.DB, master.DB)
+	}
+	if opt.Password == "" {
+		opt.Username, opt.Password = master.Username, master.Password
+	}
+	opt.MaxRetries = master.MaxRetries
+	opt.MinRetryBackoff = master.MinRetryBackoff
+	opt.MaxRetryBackoff = master.MaxRetryBackoff
+	opt.ReadTimeout = master.ReadTimeout
+	opt.WriteTimeout = master.WriteTimeout
+	opt.MaintNotificationsConfig = master.MaintNotificationsConfig
+
+	interval := maxLag / 4
+	if interval > 500*time.Millisecond {
+		interval = 500 * time.Millisecond
+	}
+	r := &redisReplica{
+		m:   m,
+		cli: redis.NewClient(opt),
+		probe: redis.NewClient(&redis.Options{
+			Network: master.Network, Addr: master.Addr, Dialer: master.Dialer, TLSConfig: master.TLSConfig,
+			Username: master.Username, Password: master.Password, DB: master.DB,
+			MaxRetries: -1, DialerRetries: 1, PoolSize: 1, ContextTimeoutEnabled: true, DisableIdentity: true,
+			DialTimeout: masterTimeout, ReadTimeout: masterTimeout, WriteTimeout: masterTimeout,
+			MaintNotificationsConfig: master.MaintNotificationsConfig,
+		}),
+		addr:     opt.Addr,
+		maxLag:   maxLag,
+		timeout:  masterTimeout,
+		interval: interval,
+		modeG: prometheus.NewGauge(prometheus.GaugeOpts{
+			Name: "meta_replica_mode",
+			Help: "Where reads outside transactions go: -1 not checked yet, 0 master, 1 replica, 2 offline (stale replica, master unreachable).",
+		}),
+		lagG: prometheus.NewGauge(prometheus.GaugeOpts{
+			Name: "meta_replica_lag_seconds",
+			Help: "How far the read replica may be behind the master, in seconds (-1 until known).",
+		}),
+		done: make(chan struct{}),
+	}
+	r.key.Store(rywKey{})
+	r.mode.Store(replicaModeUnknown)
+	r.modeG.Set(float64(replicaModeUnknown))
+	r.lagG.Set(-1)
+	r.lastAnswer.Store(time.Now().UnixNano())
+	r.offline.Store(newOfflineSignal())
+	m.rdb.AddHook(r)
+	r.probe.AddHook(probeHook{r})
+	logger.Infof("Read replica %s with max lag %s, checked every %s, master timeout %s", r.addr, maxLag, interval, masterTimeout)
+	r.wg.Add(2)
+	go r.loop(r.probeMaster)
+	go r.loop(r.check)
+	return r, nil
+}
+
+func (m *redisMeta) rywKey(sid uint64) string {
+	return m.prefix + "ryw" + strconv.FormatUint(sid, 10)
+}
+
+// rd returns the client for a read outside a transaction: the replica when it can serve it.
+func (m *redisMeta) rd(ctx context.Context) redis.Cmdable {
+	if m.replica != nil && m.replica.usable(ctx) {
+		return m.replica.cli
+	}
+	return m.rdb
+}
+
+// rywKey is the read-your-writes counter: a field of the hash ryw$sid, named at random for each
+// client and reset, so that a stale replica never holds it from an earlier use of the same sid.
+type rywKey struct{ key, field string }
+
+func (r *redisReplica) ryw() rywKey { return r.key.Load().(rywKey) }
+
+func (k rywKey) incr(ctx context.Context) *redis.IntCmd {
+	return redis.NewIntCmd(ctx, "hincrby", k.key, k.field, 1)
+}
+
+func (k rywKey) is(cmd redis.Cmder) bool {
+	a := cmd.Args()
+	return cmd.Name() == "hincrby" && len(a) == 4 && a[1] == k.key && a[2] == k.field
+}
+
+func (r *redisReplica) setSession(sid uint64) {
+	r.key.Store(rywKey{r.m.rywKey(sid), fmt.Sprintf("%016x", rand.Uint64())})
+}
+
+// afterReset restarts read-your-writes: the reset deleted the key, and a write in MULTI/EXEC
+// orders the reads after it.
+func (r *redisReplica) afterReset(ctx context.Context) error {
+	r.required.Store(0)
+	r.reached.Store(0)
+	k := r.ryw()
+	if k.key == "" {
+		return nil
+	}
+	r.key.Store(rywKey{k.key, fmt.Sprintf("%016x", rand.Uint64())})
+	_, err := r.m.rdb.TxPipelined(ctx, func(pipe redis.Pipeliner) error {
+		pipe.Ping(ctx)
+		return nil
+	})
+	return err
+}
+
+func maxInt64(v *atomic.Int64, n int64) {
+	for {
+		old := v.Load()
+		if n <= old || v.CompareAndSwap(old, n) {
+			return
+		}
+	}
+}
+
+func (r *redisReplica) usable(ctx context.Context) bool {
+	k := r.ryw()
+	if k.key == "" && !r.m.conf.ReadOnly {
+		return false // no session yet: writes are not tracked
+	}
+	switch r.mode.Load() {
+	case replicaModeOffline:
+		return true
+	case replicaModeUnknown, replicaModeMaster:
+		return false
+	}
+	if time.Since(time.Unix(0, r.freshAt.Load())) > r.maxLag {
+		return false // the check loop is late, do not trust the last sample
+	}
+	need := r.required.Load()
+	if r.reached.Load() >= need {
+		return true
+	}
+	// Wait for our last write to reach the replica, at most as long as reading from the master.
+	wait := time.Duration(r.rtt.Load())
+	if wait > r.maxLag {
+		wait = r.maxLag
+	}
+	deadline := time.Now().Add(wait)
+	for {
+		v, err := r.cli.HGet(ctx, k.key, k.field).Int64()
+		if err != nil && err != redis.Nil {
+			logger.Debugf("Read replica %s: hget %s %s: %s", r.addr, k.key, k.field, err)
+			return false
+		}
+		maxInt64(&r.reached, v)
+		if v >= need {
+			return true
+		}
+		if time.Now().After(deadline) {
+			return false
+		}
+		time.Sleep(200 * time.Microsecond)
+	}
+}
+
+// masterConn is a connection to the master: every byte it reads is an answer of the master.
+type masterConn struct {
+	net.Conn
+	r *redisReplica
+}
+
+func (c *masterConn) Read(b []byte) (int, error) {
+	n, err := c.Conn.Read(b)
+	if n > 0 {
+		c.r.lastAnswer.Store(time.Now().UnixNano())
+	}
+	return n, err
+}
+
+func (c *masterConn) Close() error {
+	c.r.conns.Delete(c)
+	return c.Conn.Close()
+}
+
+// DialHook tracks the connections to the master, to know when it last answered and to close them
+// when going offline.
+func (r *redisReplica) DialHook(next redis.DialHook) redis.DialHook {
+	return func(ctx context.Context, network, addr string) (net.Conn, error) {
+		conn, err := next(ctx, network, addr)
+		if err != nil {
+			return conn, err
+		}
+		c := &masterConn{conn, r}
+		r.conns.Store(c, struct{}{})
+		return c, nil
+	}
+}
+
+// probeHook tracks the probe's connections, without the rest of the master's hooks.
+type probeHook struct{ r *redisReplica }
+
+func (h probeHook) DialHook(next redis.DialHook) redis.DialHook { return h.r.DialHook(next) }
+
+func (h probeHook) ProcessHook(next redis.ProcessHook) redis.ProcessHook { return nil }
+
+func (h probeHook) ProcessPipelineHook(next redis.ProcessPipelineHook) redis.ProcessPipelineHook {
+	return nil
+}
+
+// guard bounds a command to the master by twice the master timeout (going offline stops it
+// sooner), stops it when the client goes offline, and fails it at once while offline.
+func (r *redisReplica) guard(ctx context.Context) (context.Context, func(), error) {
+	sig := r.offline.Load()
+	if r.mode.Load() == replicaModeOffline {
+		return nil, nil, syscall.EROFS
+	}
+	ctx, cancel := context.WithTimeout(ctx, 2*r.timeout)
+	stop := context.AfterFunc(sig.ctx, cancel)
+	return ctx, func() { stop(); cancel() }, nil
+}
+
+// answered tells a reply of the master, even an error, from no reply.
+func answered(err error) bool {
+	var rerr redis.Error
+	return err == nil || err == redis.Nil || err == redis.TxFailedErr || errors.As(err, &rerr)
+}
+
+// after makes a command stopped by going offline fail with EROFS.
+func (r *redisReplica) after(err error) error {
+	if !answered(err) && r.mode.Load() == replicaModeOffline {
+		return syscall.EROFS
+	}
+	return err
+}
+
+// refused tells the errors that prove the master unreachable at once: the connection is refused,
+// there is no route, or the name does not resolve. A timeout proves nothing: the master may be slow.
+func refused(err error) bool {
+	var dnsErr *net.DNSError
+	if errors.As(err, &dnsErr) {
+		return dnsErr.IsNotFound
+	}
+	var opErr *net.OpError
+	if !errors.As(err, &opErr) || opErr.Op != "dial" {
+		return false
+	}
+	return errors.Is(err, syscall.ECONNREFUSED) || errors.Is(err, syscall.ENETUNREACH) ||
+		errors.Is(err, syscall.EHOSTUNREACH) || errors.Is(err, syscall.ECONNRESET)
+}
+
+func (r *redisReplica) ProcessHook(next redis.ProcessHook) redis.ProcessHook {
+	return func(ctx context.Context, cmd redis.Cmder) error {
+		ctx, done, err := r.guard(ctx)
+		if err != nil {
+			cmd.SetErr(err)
+			return err
+		}
+		defer done()
+		if err = r.after(next(ctx, cmd)); err == syscall.EROFS {
+			cmd.SetErr(err)
+		}
+		return err
+	}
+}
+
+// ProcessPipelineHook adds HINCRBY ryw$sid to every MULTI/EXEC sent to the master, in the same round trip.
+func (r *redisReplica) ProcessPipelineHook(next redis.ProcessPipelineHook) redis.ProcessPipelineHook {
+	return func(ctx context.Context, cmds []redis.Cmder) error {
+		ctx, done, err := r.guard(ctx)
+		if err == nil {
+			defer done()
+			err = r.after(r.pipeline(ctx, next, cmds))
+		}
+		if err == syscall.EROFS {
+			for _, cmd := range cmds {
+				cmd.SetErr(err)
+			}
+		}
+		return err
+	}
+}
+
+func (r *redisReplica) pipeline(ctx context.Context, next redis.ProcessPipelineHook, cmds []redis.Cmder) error {
+	k := r.ryw()
+	n := len(cmds)
+	if k.key == "" || n < 2 || cmds[0].Name() != "multi" || cmds[n-1].Name() != "exec" {
+		return next(ctx, cmds)
+	}
+	// first in the transaction, so that a session cleanup in the same transaction deletes it
+	incr := k.incr(ctx)
+	wrapped := make([]redis.Cmder, 0, n+1)
+	wrapped = append(wrapped, cmds[0], incr)
+	wrapped = append(wrapped, cmds[1:]...)
+	err := next(ctx, wrapped)
+	if v, e := incr.Result(); e == nil {
+		maxInt64(&r.required, v)
+	}
+	return err
+}
+
+func parseReplicationInfo(info string) map[string]string {
+	fields := make(map[string]string)
+	for _, line := range strings.Split(info, "\n") {
+		if k, v, ok := strings.Cut(strings.TrimSpace(line), ":"); ok {
+			fields[k] = v
+		}
+	}
+	return fields
+}
+
+func (r *redisReplica) loop(f func()) {
+	defer r.wg.Done()
+	ticker := time.NewTicker(r.interval)
+	defer ticker.Stop()
+	for {
+		f()
+		select {
+		case <-r.done:
+			return
+		case <-ticker.C:
+		}
+	}
+}
+
+const maxReplicaSamples = 64
+
+// probeMaster samples master_repl_offset on the master. It runs apart from check, because a
+// probe may wait for the master timeout.
+func (r *redisReplica) probeMaster() {
+	start := time.Now()
+	ctx, cancel := context.WithTimeout(context.Background(), r.timeout)
+	info, err := r.probe.Info(ctx, "replication").Result()
+	cancel()
+	mf := parseReplicationInfo(info)
+	offset, perr := strconv.ParseInt(mf["master_repl_offset"], 10, 64)
+	if err == nil && perr != nil {
+		err = fmt.Errorf("bad master_repl_offset %q", mf["master_repl_offset"])
+	}
+	r.mu.Lock()
+	r.masterErr = err
+	if err == nil {
+		rtt := time.Since(start)
+		r.rtt.Store(int64(rtt))
+		if r.replid != mf["master_replid"] {
+			r.replid, r.samples = mf["master_replid"], r.samples[:0]
+		}
+		if len(r.samples) == maxReplicaSamples {
+			r.samples = r.samples[1:] // dropping a sample only makes the lag look larger
+		}
+		// the master answered at about half the round trip: a read from it would not be fresher
+		r.samples = append(r.samples, replicaSample{start.Add(rtt / 2).UnixNano(), offset})
+	}
+	r.mu.Unlock()
+	if refused(err) && r.servable.Load() {
+		r.setMode(replicaModeOffline, fmt.Sprintf("master unreachable: %s", err))
+	}
+}
+
+// check samples the replica and picks the mode.
+func (r *redisReplica) check() {
+	ctx, cancel := context.WithTimeout(context.Background(), r.interval)
+	info, replicaDown := r.cli.Info(ctx, "replication").Result()
+	cancel()
+	rf := parseReplicationInfo(info)
+
+	r.mu.Lock()
+	replid, masterErr := r.replid, r.masterErr
+	replicaOffset, err := strconv.ParseInt(rf["master_repl_offset"], 10, 64)
+	var replicaErr error
+	switch {
+	case replicaDown != nil:
+		replicaErr = replicaDown
+	case rf["role"] != "slave":
+		replicaErr = fmt.Errorf("role is %s", rf["role"])
+	case rf["master_link_status"] != "up":
+		replicaErr = fmt.Errorf("replication link is %s", rf["master_link_status"])
+	case rf["master_replid"] != replid:
+		replicaErr = fmt.Errorf("replication id %q differs from the master's %q", rf["master_replid"], replid)
+	case err != nil:
+		replicaErr = fmt.Errorf("bad master_repl_offset %q", rf["master_repl_offset"])
+	}
+	if replicaErr == nil {
+		// the newest master sample reached by the replica tells how fresh it is
+		var i int
+		for i < len(r.samples) && r.samples[i].offset <= replicaOffset {
+			r.freshAt.Store(r.samples[i].at)
+			i++
+		}
+		r.samples = r.samples[i:]
+	}
+	r.mu.Unlock()
+	servable := replicaDown == nil && replid != "" && rf["master_replid"] == replid
+	r.servable.Store(servable)
+	lag := r.updateLag()
+	silence := time.Since(time.Unix(0, r.lastAnswer.Load()))
+
+	if r.mode.Load() == replicaModeOffline {
+		switch {
+		case !servable:
+			r.setMode(replicaModeMaster, fmt.Sprintf("replica unreachable (%v) or not a copy of the master (replication id %q, not %q)",
+				replicaDown, rf["master_replid"], replid))
+			return
+		case r.lastAnswer.Load() <= r.offline.Load().since.Load():
+			return // still no answer from the master
+		}
+	}
+	var rerr redis.Error
+	switch {
+	case masterErr != nil && errors.As(masterErr, &rerr):
+		// the master answers, but not as expected (ACL, configuration): not an outage
+		r.setMode(replicaModeMaster, fmt.Sprintf("master: %s", masterErr))
+	case refused(masterErr) || silence >= r.timeout:
+		if servable {
+			r.setMode(replicaModeOffline, fmt.Sprintf("master unreachable for %s: %v", silence.Truncate(time.Millisecond), masterErr))
+		} else {
+			r.setMode(replicaModeMaster, fmt.Sprintf("master unreachable: %v; replica unreachable (%v) or not a copy of the master", masterErr, replicaDown))
+		}
+	case replicaErr != nil:
+		r.setMode(replicaModeMaster, fmt.Sprintf("replica: %s", replicaErr))
+	case lag < 0:
+		r.setMode(replicaModeMaster, "replica freshness not known yet")
+	case lag > r.maxLag:
+		r.setMode(replicaModeMaster, fmt.Sprintf("replica lag %s exceeds %s", lag.Truncate(time.Millisecond), r.maxLag))
+	default:
+		r.setMode(replicaModeReplica, fmt.Sprintf("lag %s", lag.Truncate(time.Millisecond)))
+	}
+}
+
+// updateLag returns how far the replica may be behind the master, -1 when not known yet.
+func (r *redisReplica) updateLag() time.Duration {
+	at := r.freshAt.Load()
+	if at == 0 {
+		return -1
+	}
+	lag := time.Since(time.Unix(0, at))
+	r.lagG.Set(lag.Seconds())
+	return lag
+}
+
+func (r *redisReplica) setMode(mode int32, reason string) {
+	r.modeMu.Lock() // the probe and check loops both change it
+	defer r.modeMu.Unlock()
+	old := r.mode.Swap(mode)
+	if old == mode {
+		return
+	}
+	if mode == replicaModeOffline {
+		sig := r.offline.Load()
+		sig.since.Store(time.Now().UnixNano())
+		sig.cancel() // commands still waiting for the master fail with EROFS
+		r.conns.Range(func(c, _ any) bool {
+			_ = c.(*masterConn).Close() // and so do those blocked reading a reply
+			return true
+		})
+	} else if old == replicaModeOffline {
+		r.offline.Store(newOfflineSignal())
+	}
+	r.modeG.Set(float64(mode))
+	if mode == replicaModeReplica {
+		logger.Infof("Read replica %s: mode %s -> %s (%s)", r.addr, replicaModeName(old), replicaModeName(mode), reason)
+	} else {
+		logger.Warnf("Read replica %s: mode %s -> %s (%s)", r.addr, replicaModeName(old), replicaModeName(mode), reason)
+	}
+}
+
+// stop stops the loops.
+func (r *redisReplica) stop() {
+	r.once.Do(func() { close(r.done) })
+	r.wg.Wait()
+}
+
+func (r *redisReplica) close() error {
+	r.stop() // the loops use the clients
+	if err := r.probe.Close(); err != nil {
+		logger.Warnf("close probe of the master: %s", err)
+	}
+	return r.cli.Close()
+}
