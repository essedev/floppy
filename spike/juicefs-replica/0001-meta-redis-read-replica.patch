+				e.follow(t, net.JoinHostPort(e.self, rp.port()))
+				defer e.follow(t, e.master)
+			}
+			cp := newTCPProxy(t, e.master)
+			cp.delay.Store(int64(c.clientDelay / 2))
+			m := e.newMeta(t, "127.0.0.1:"+cp.port(), replicaQuery(e, "2s"))
+			e.format(t, m)
+			waitMode(t, m, replicaModeReplica, 5*time.Second)
+			ctx := Background()
+
+			var dir Ino
+			var attr Attr
+			if st := m.Mkdir(ctx, RootInode, "d", 0755, 0, 0, &dir, &attr); st != 0 {
+				t.Fatalf("mkdir: %s", st)
+			}
+			before := e.replicaCalls(t, "hget")
+			const n = 1000
+			var stale int
+			start := time.Now()
+			for i := 0; i < n; i++ {
+				name := fmt.Sprintf("f%d", i)
+				var ino Ino
+				if st := m.Create(ctx, dir, name, 0644, 0, 0, &ino, &attr); st != 0 {
+					t.Fatalf("create %s: %s", name, st)
+				}
+				var found Ino
+				if st := m.en.doLookup(ctx, dir, name, &found, &attr); st != 0 || found != ino {
+					stale++
+				}
+				val := []byte(strconv.Itoa(i))
+				if st := m.SetXattr(ctx, ino, "user.v", val, 0); st != 0 {
+					t.Fatalf("setxattr: %s", st)
+				}
+				var got []byte
+				if st := m.GetXattr(ctx, ino, "user.v", &got); st != 0 || string(got) != string(val) {
+					stale++
+				}
+				if st := m.Unlink(ctx, dir, name); st != 0 {
+					t.Fatalf("unlink: %s", st)
+				}
+				if st := m.en.doLookup(ctx, dir, name, &found, &attr); st != syscall.ENOENT {
+					stale++
+				}
+			}
+			served := e.replicaCalls(t, "hget") - before
+			t.Logf("%s: %d write/read rounds in %s, %d stale reads, %d HGET on the replica (%d reads, plus the transactions' own)",
+				c.name, n, time.Since(start).Truncate(time.Millisecond), stale, served, 3*n)
+			if stale > 0 {
+				t.Fatalf("%d stale reads", stale)
+			}
+		})
+	}
+}
