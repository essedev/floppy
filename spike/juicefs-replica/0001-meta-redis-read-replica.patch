+// tcpProxy forwards to target, delays every byte by delay, can be cut or drop everything
+// (blackhole), and counts the requests: the chunks sent by the client, one per round trip.
+type tcpProxy struct {
+	target    string
+	ln        net.Listener
+	delay     atomic.Int64 // both directions
+	slow      atomic.Int64 // replies only, plus or minus jitter
+	jitter    atomic.Int64
+	blackhole atomic.Bool
+	requests  atomic.Int64
+	mu        sync.Mutex
+	conns     map[net.Conn]struct{}
+}
+
+func newTCPProxy(t *testing.T, target string) *tcpProxy {
+	p := &tcpProxy{target: target, conns: make(map[net.Conn]struct{})}
+	ln, err := net.Listen("tcp", ":0")
+	if err != nil {
+		t.Fatalf("listen: %s", err)
+	}
+	p.ln = ln
+	go p.serve(ln)
+	t.Cleanup(p.cut)
+	return p
+}
+
+func (p *tcpProxy) port() string {
+	_, port, _ := net.SplitHostPort(p.ln.Addr().String())
+	return port
+}
+
+func (p *tcpProxy) serve(ln net.Listener) {
+	for {
+		c, err := ln.Accept()
+		if err != nil {
+			return
+		}
+		u, err := net.Dial("tcp", p.target)
+		if err != nil {
+			_ = c.Close()
+			continue
+		}
+		p.mu.Lock()
+		p.conns[c], p.conns[u] = struct{}{}, struct{}{}
+		p.mu.Unlock()
+		go p.pipe(c, u, false)
+		go p.pipe(u, c, true)
+	}
+}
+
+type proxyChunk struct {
+	at   time.Time
+	data []byte
+}
+
+func (p *tcpProxy) pipe(dst, src net.Conn, request bool) {
+	ch := make(chan proxyChunk, 1024)
+	go func() {
+		defer close(ch)
+		for {
+			buf := make([]byte, 64<<10)
+			n, err := src.Read(buf)
+			if n > 0 {
+				ch <- proxyChunk{time.Now(), buf[:n]}
+			}
+			if err != nil {
+				return
+			}
+		}
+	}()
+	for c := range ch {
+		if p.blackhole.Load() {
+			continue
+		}
+		d := time.Duration(p.delay.Load())
+		if request {
+			p.requests.Add(1)
+		} else if slow := p.slow.Load(); slow > 0 {
+			d += time.Duration(slow)
+			if j := p.jitter.Load(); j > 0 {
+				d += time.Duration(rand.Int63n(2*j) - j)
+			}
+		}
+		time.Sleep(time.Until(c.at.Add(d)))
+		if _, err := dst.Write(c.data); err != nil {
+			break
+		}
+	}
+	_ = dst.Close()
+	_ = src.Close()
+}
+
+func (p *tcpProxy) cut() {
+	_ = p.ln.Close()
+	p.closeConns()
+}
+
+// closeConns drops the connections, which a blackhole leaves out of sync.
+func (p *tcpProxy) closeConns() {
+	p.mu.Lock()
+	for c := range p.conns {
+		_ = c.Close()
+	}
+	p.conns = make(map[net.Conn]struct{})
+	p.mu.Unlock()
+}
+
+func (p *tcpProxy) restore(t *testing.T) {
+	ln, err := net.Listen("tcp", p.ln.Addr().String())
+	if err != nil {
+		t.Fatalf("listen again: %s", err)
+	}
+	p.ln = ln
+	go p.serve(ln)
+}
+
+func replicaQuery(e *replicaEnv, maxLag string) string {
+	return "max-lag=" + maxLag + "&read-replica=redis://" + e.replica
+}
