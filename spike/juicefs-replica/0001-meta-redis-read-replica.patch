+	}
+	cp.slow.Store(int64(1200 * time.Millisecond))
+	cp.jitter.Store(int64(600 * time.Millisecond))
+	defer cp.slow.Store(0)
+
+	var writes, failed, erofs atomic.Int64
+	var slowest atomic.Int64
+	var offline atomic.Bool
+	stop := make(chan struct{})
+	var wg sync.WaitGroup
+	for w := 0; w < 4; w++ {
+		wg.Add(1)
+		go func(w int) {
+			defer wg.Done()
+			for i := 0; ; i++ {
+				select {
+				case <-stop:
+					return
+				default:
+				}
+				start := time.Now()
+				var st syscall.Errno
+				if i%2 == 0 {
+					st = m.SetXattr(ctx, ino, fmt.Sprintf("user.w%d", w), []byte(strconv.Itoa(i)), 0)
+				} else {
+					var f Ino
+					st = m.Create(ctx, RootInode, fmt.Sprintf("w%d-%d", w, i), 0644, 0, 0, &f, &attr)
+				}
+				maxInt64(&slowest, int64(time.Since(start)))
+				switch st {
+				case 0:
+					writes.Add(1)
+				case syscall.EROFS:
+					erofs.Add(1)
+				default:
+					failed.Add(1)
+					t.Logf("write failed: %s", st)
+				}
+			}
+		}(w)
+	}
+	deadline := time.Now().Add(30 * time.Second)
+	for time.Now().Before(deadline) {
+		if m.replica.mode.Load() == replicaModeOffline {
+			offline.Store(true)
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	close(stop)
+	wg.Wait()
+	t.Logf("slow master for 30s: %d writes OK, %d failed, %d EROFS, slowest %s, offline seen: %t",
+		writes.Load(), failed.Load(), erofs.Load(), time.Duration(slowest.Load()).Truncate(time.Millisecond), offline.Load())
+	if erofs.Load() > 0 || failed.Load() > 0 || offline.Load() || writes.Load() == 0 {
+		t.Fatalf("a slow master was taken for a missing one")
+	}
+}
