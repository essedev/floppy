+func TestRedisReplicaConcurrentWriters(t *testing.T) {
+	e := newReplicaEnv(t)
+	cp := newTCPProxy(t, e.master)
+	cp.delay.Store(int64(5 * time.Millisecond))
+	m := e.newMeta(t, "127.0.0.1:"+cp.port(), replicaQuery(e, "2s"))
+	e.format(t, m)
+	waitMode(t, m, replicaModeReplica, 5*time.Second)
+	ctx := Background()
+
+	const writers, rounds = 16, 100
+	var stale atomic.Int64
+	var wg sync.WaitGroup
+	handoff := make(chan [2]uint64, writers)
+	for w := 0; w < writers; w++ {
+		var ino Ino
+		var attr Attr
+		if st := m.Create(ctx, RootInode, fmt.Sprintf("w%d", w), 0644, 0, 0, &ino, &attr); st != 0 {
+			t.Fatalf("create: %s", st)
+		}
+		wg.Add(1)
+		go func(ino Ino) {
+			defer wg.Done()
+			for i := 1; i <= rounds; i++ {
+				val := []byte(strconv.Itoa(i))
+				if st := m.SetXattr(ctx, ino, "user.v", val, 0); st != 0 {
+					t.Errorf("setxattr: %s", st)
+					return
+				}
+				var got []byte
+				if st := m.GetXattr(ctx, ino, "user.v", &got); st != 0 || string(got) != string(val) {
+					stale.Add(1)
+				}
+				handoff <- [2]uint64{uint64(ino), uint64(i)} // another goroutine reads it after the write returned
+			}
+		}(ino)
+	}
+	var readers sync.WaitGroup
+	readers.Add(1)
+	go func() {
+		defer readers.Done()
+		for h := range handoff {
+			var got []byte
+			if st := m.GetXattr(ctx, Ino(h[0]), "user.v", &got); st != 0 {
+				stale.Add(1)
+			} else if v, _ := strconv.ParseUint(string(got), 10, 64); v < h[1] {
+				stale.Add(1)
+			}
+		}
+	}()
+	wg.Wait()
+	close(handoff)
+	readers.Wait()
+	t.Logf("%d writers x %d rounds: %d stale reads, required %d", writers, rounds, stale.Load(), m.replica.required.Load())
+	if stale.Load() > 0 {
+		t.Fatalf("%d stale reads", stale.Load())
+	}
+}
