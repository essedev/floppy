+// The tests need a master and a replica of it:
+//
+//	JFS_TEST_REPLICA_MASTER=valkey-master:6379 JFS_TEST_REPLICA=valkey-replica:6379 \
+//	JFS_TEST_REPLICA_SELF=<address of this host as seen by the replica> META_PASSWORD=...
+
+type replicaEnv struct {
+	master, replica, self, password string
+	mcli, rcli                      *redis.Client
+}
+
+func newReplicaEnv(t *testing.T) *replicaEnv {
+	e := &replicaEnv{
+		master:   os.Getenv("JFS_TEST_REPLICA_MASTER"),
+		replica:  os.Getenv("JFS_TEST_REPLICA"),
+		self:     os.Getenv("JFS_TEST_REPLICA_SELF"),
+		password: os.Getenv("META_PASSWORD"),
+	}
+	if e.master == "" || e.replica == "" {
+		t.Skip("JFS_TEST_REPLICA_MASTER and JFS_TEST_REPLICA are not set")
+	}
+	e.mcli = redis.NewClient(&redis.Options{Addr: e.master, Password: e.password})
+	e.rcli = redis.NewClient(&redis.Options{Addr: e.replica, Password: e.password})
+	t.Cleanup(func() {
+		e.follow(t, e.master)
+		_ = e.mcli.Close()
+		_ = e.rcli.Close()
+	})
+	e.follow(t, e.master)
