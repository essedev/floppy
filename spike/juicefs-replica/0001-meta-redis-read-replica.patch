+// Round trips to the master per operation, with and without the read replica.
+func TestRedisReplicaRoundTrips(t *testing.T) {
+	e := newReplicaEnv(t)
+	ops := []string{"create", "mkdir", "setattr-times", "setattr-mode", "truncate", "setxattr", "removexattr", "write", "unlink"}
+	measure := func(query string) map[string]float64 {
+		cp := newTCPProxy(t, e.master)
+		m := e.newMeta(t, "127.0.0.1:"+cp.port(), query)
+		e.format(t, m)
+		if m.replica != nil {
+			waitMode(t, m, replicaModeReplica, 5*time.Second)
+			m.replica.stop() // no INFO in the counts
+		}
+		ctx := Background()
+		var dir Ino
+		var attr Attr
+		if st := m.Mkdir(ctx, RootInode, "d", 0755, 0, 0, &dir, &attr); st != 0 {
+			t.Fatalf("mkdir: %s", st)
+		}
+		const n = 50
+		inos := make([]Ino, n)
+		var sliceID uint64
+		if st := m.NewSlice(ctx, &sliceID); st != 0 {
+			t.Fatalf("new slice: %s", st)
+		}
+		res := make(map[string]float64)
+		for _, op := range ops {
+			before := cp.requests.Load()
+			for i := 0; i < n; i++ {
+				var st syscall.Errno
+				name := fmt.Sprintf("f%d", i)
+				switch op {
+				case "create":
+					st = m.Create(ctx, dir, name, 0644, 0, 0, &inos[i], &attr)
+				case "mkdir":
+					var sub Ino
+					st = m.Mkdir(ctx, dir, "s"+name, 0755, 0, 0, &sub, &attr)
+				case "setattr-times":
+					st = m.SetAttr(ctx, inos[i], SetAttrAtime|SetAttrMtime, 0, &Attr{Atime: 1, Mtime: 2})
+				case "setattr-mode":
+					st = m.SetAttr(ctx, inos[i], SetAttrMode, 0, &Attr{Mode: 0600})
+				case "truncate":
+					st = m.Truncate(ctx, inos[i], 0, 1<<20, &attr, false)
+				case "setxattr":
+					st = m.SetXattr(ctx, inos[i], "com.apple.provenance", []byte("v"), 0)
+				case "removexattr":
+					st = m.RemoveXattr(ctx, inos[i], "com.apple.provenance")
+				case "write":
+					st = m.Write(ctx, inos[i], 0, 0, Slice{Id: sliceID, Size: 4096, Len: 4096}, time.Now())
+				case "unlink":
+					st = m.Unlink(ctx, dir, name)
+				}
+				if st != 0 {
+					t.Fatalf("%s %d: %s", op, i, st)
+				}
+			}
+			res[op] = float64(cp.requests.Load()-before) / n
+		}
+		if m.replica != nil {
+			t.Logf("optimistic: %d conflicts, %d fallbacks", m.replica.conflicts.Load(), m.replica.fallbacks.Load())
+		}
+		return res
+	}
+	upstream := measure("")
+	replica := measure(replicaQuery(e, "1h"))
+	for _, op := range ops {
+		t.Logf("%-14s round trips to the master: %.2f without replica, %.2f with", op, upstream[op], replica[op])
+	}
+	for _, op := range ops {
+		if replica[op] > 1.1 {
+			t.Errorf("%s takes %.2f round trips with the replica", op, replica[op])
+		}
+	}
+}
