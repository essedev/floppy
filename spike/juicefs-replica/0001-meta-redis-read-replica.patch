+// Optimistic transactions: a conflict and the commands that cannot run optimistically fall back to WATCH.
+func TestRedisReplicaOptimistic(t *testing.T) {
+	e := newReplicaEnv(t)
+	m := e.newMeta(t, e.master, replicaQuery(e, "2s"))
+	e.format(t, m)
+	waitMode(t, m, replicaModeReplica, 5*time.Second)
+	ctx := Background()
+	k, k2 := m.prefix+"test-k", m.prefix+"test-k2"
+	mcli := redis.NewClient(&redis.Options{Addr: e.master, Password: e.password, DB: 3}) // the database of newMeta
+	defer mcli.Close()
+	if err := m.txn(ctx, func(tx *redis.Tx) error {
+		_, err := tx.TxPipelined(ctx, func(pipe redis.Pipeliner) error {
+			pipe.Set(ctx, k, "1", 0)
+			return nil
+		})
+		return err
+	}, k); err != nil {
+		t.Fatalf("set: %s", err)
+	}
+
+	// a concurrent write between the read and the commit
+	var attempts int
+	err := m.txn(ctx, func(tx *redis.Tx) error {
+		attempts++
+		v, err := tx.Get(ctx, k).Result()
+		if err != nil {
+			return err
+		}
+		if attempts == 1 {
+			if err := mcli.Set(context.Background(), k, "2", 0).Err(); err != nil {
+				return err
+			}
+		}
+		_, err = tx.TxPipelined(ctx, func(pipe redis.Pipeliner) error {
+			pipe.Set(ctx, k2, "seen "+v, 0)
+			return nil
+		})
+		return err
+	}, k)
+	if got := mcli.Get(context.Background(), k2).Val(); err != nil || got != "seen 2" || attempts != 2 {
+		t.Fatalf("conflict: %v, k2 = %q after %d attempts", err, got, attempts)
+	}
+	if m.replica.conflicts.Load() != 1 {
+		t.Fatalf("%d conflicts, expected 1", m.replica.conflicts.Load())
+	}
+
+	// a write outside MULTI/EXEC and a SCAN cannot be checked: run with WATCH, applied once
+	for i, txf := range []func(tx *redis.Tx) error{
+		func(tx *redis.Tx) error { return tx.Incr(ctx, k).Err() },
+		func(tx *redis.Tx) error {
+			if err := tx.Scan(ctx, 0, k, 10).Err(); err != nil {
+				return err
+			}
+			_, err := tx.TxPipelined(ctx, func(pipe redis.Pipeliner) error {
+				pipe.Incr(ctx, k)
+				return nil
+			})
+			return err
+		},
+	} {
+		if err := m.txn(ctx, txf, k); err != nil {
+			t.Fatalf("fallback %d: %s", i, err)
+		}
+	}
+	if got := mcli.Get(context.Background(), k).Val(); got != "4" || m.replica.fallbacks.Load() != 2 {
+		t.Fatalf("k = %q, %d fallbacks: expected 4 and 2", got, m.replica.fallbacks.Load())
+	}
+
+	// a command too long for unpack() in Lua runs with WATCH too
+	fields := make([]string, 10000)
+	for i := range fields {
+		fields[i] = strconv.Itoa(i)
+	}
+	if err := m.txn(ctx, func(tx *redis.Tx) error {
+		_, err := tx.TxPipelined(ctx, func(pipe redis.Pipeliner) error {
+			pipe.HDel(ctx, k2+"h", fields...)
+			return nil
+		})
+		return err
+	}, k2+"h"); err != nil || m.replica.fallbacks.Load() != 3 {
+		t.Fatalf("long command: %v, %d fallbacks, expected 3", err, m.replica.fallbacks.Load())
+	}
+
+	// a transaction without writes still checks its reads on the master: with replication slowed
+	// down, the replica still has the old value of k when the transaction reads it
+	if e.self == "" {
+		t.Skip("JFS_TEST_REPLICA_SELF is not set")
+	}
+	rp := newTCPProxy(t, e.master)
+	e.follow(t, net.JoinHostPort(e.self, rp.port()))
+	defer e.follow(t, e.master)
+	rp.delay.Store(int64(500 * time.Millisecond))
+	if err := mcli.Set(context.Background(), k, "5", 0).Err(); err != nil {
+		t.Fatalf("set: %s", err)
+	}
+	before := m.replica.conflicts.Load()
+	var seen string
+	if err := m.txn(ctx, func(tx *redis.Tx) error {
+		v, err := tx.Get(ctx, k).Result()
+		seen = v
+		return err
+	}, k); err != nil || seen != "5" {
+		t.Fatalf("read-only transaction: %v, %q", err, seen)
+	}
+	if n := m.replica.conflicts.Load() - before; n != 1 {
+		t.Fatalf("read-only transaction on a stale replica: %d conflicts, expected 1", n)
+	}
+}
