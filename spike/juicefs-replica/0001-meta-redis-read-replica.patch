+	cp := newTCPProxy(t, e.master)
+	m := e.newMeta(t, "127.0.0.1:"+cp.port(), replicaQuery(e, "1s"))
+	e.format(t, m)
+	reg := prometheus.NewRegistry()
+	m.InitMetrics(reg)
+	waitMode(t, m, replicaModeReplica, 5*time.Second)
+	ctx := Background()
+	var dir, ino Ino
+	var attr Attr
+	if st := m.Mkdir(ctx, RootInode, "d", 0755, 0, 0, &dir, &attr); st != 0 {
+		t.Fatalf("mkdir: %s", st)
+	}
+	if st := m.Create(ctx, dir, "f", 0644, 0, 0, &ino, &attr); st != 0 {
+		t.Fatalf("create: %s", st)
+	}
+	if st := m.SetXattr(ctx, ino, "user.v", []byte("before"), 0); st != 0 {
+		t.Fatalf("setxattr: %s", st)
+	}
+
+	cp.cut()
+	if err := e.rcli.Do(context.Background(), "REPLICAOF", "127.0.0.1", "1").Err(); err != nil { // its link is down too
+		t.Fatalf("replicaof: %s", err)
+	}
+	if d := waitMode(t, m, replicaModeOffline, 3*time.Second); d > 1500*time.Millisecond {
+		t.Fatalf("refused connection: offline after %s, expected within 1.5s", d)
+	} else {
+		t.Logf("refused connection: offline after %s", d)
+	}
+	var found Ino
+	if st := m.Lookup(ctx, dir, "f", &found, &attr, false); st != 0 || found != ino {
+		t.Fatalf("lookup offline: %s", st)
+	}
+	var got []byte
+	if st := m.GetXattr(ctx, ino, "user.v", &got); st != 0 || string(got) != "before" {
+		t.Fatalf("getxattr offline: %q (%s)", got, st)
+	}
+	var entries []*Entry
+	if st := m.Readdir(ctx, dir, 1, &entries); st != 0 || len(entries) != 3 {
+		t.Fatalf("readdir offline: %d entries (%s)", len(entries), st)
+	}
+	start := time.Now()
+	if st := m.SetXattr(ctx, ino, "user.v", []byte("offline"), 0); st != syscall.EROFS {
+		t.Fatalf("setxattr offline: %s, expected EROFS", st)
+	}
+	t.Logf("write offline fails with EROFS after %s", time.Since(start))
+	if v := gaugeValue(t, reg, "meta_replica_mode"); v != float64(replicaModeOffline) {
+		t.Fatalf("meta_replica_mode = %v, expected offline", v)
+	}
+
+	// a replica that is no longer a copy of this master is not served, even offline
+	if err := e.rcli.Do(context.Background(), "REPLICAOF", "NO", "ONE").Err(); err != nil {
+		t.Fatalf("replicaof no one: %s", err)
+	}
+	t.Logf("replica promoted while offline: master mode after %s", waitMode(t, m, replicaModeMaster, 2*time.Second))
+
+	cp.restore(t)
+	e.follow(t, e.master)
+	t.Logf("master back: replica mode after %s", waitMode(t, m, replicaModeReplica, 10*time.Second))
+	if st := m.SetXattr(ctx, ino, "user.v", []byte("after"), 0); st != 0 {
+		t.Fatalf("setxattr after: %s", st)
+	}
+	if st := m.GetXattr(ctx, ino, "user.v", &got); st != 0 || string(got) != "after" {
+		t.Fatalf("getxattr after: %q (%s)", got, st)
+	}
+}
