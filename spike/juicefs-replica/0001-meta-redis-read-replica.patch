+
+package meta
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"strconv"
+
+	"github.com/redis/go-redis/v9"
+)
+
+/*
+	Optimistic transactions, used with a read replica.
+
+	A transaction on the master costs WATCH, one round trip per read, MULTI/EXEC and UNWATCH. When
+	the replica is fresh, the first attempt of txn() runs the same transaction function on a
+	redis.Tx whose commands are intercepted: reads are served by the replica and recorded, and
+	MULTI/EXEC becomes one EVALSHA of scriptCommit on the master, which checks that every recorded
+	read still returns the same value and only then applies the writes. One round trip, and the
+	transaction functions stay the only implementation of each operation.
+
+	A failed check is a conflict (redis.TxFailedErr): txn() runs the transaction again with WATCH
+	on the master. Anything that cannot be checked or replayed (SCAN, a write outside MULTI/EXEC,
+	a reply type not handled here) aborts the attempt before anything is sent, and txn() runs it
+	with WATCH too. A transaction that ends without writes still checks its reads, so that its
+	result (EEXIST, ENOENT, ...) is the master's.
+
+	Checking the values read instead of watching keys is serializable too: the transaction
+	commits only if everything it read is unchanged at commit time. Integer replies of the writes
+	go through Lua numbers, exact up to 2^53.
+*/
+
+var errOptimisticAbort = errors.New("optimistic transaction aborted")
+
+// maxScriptArgs bounds the arguments of one command in scriptCommit: unpack() in the server's
+// Lua fails beyond about 8000 values (LUAI_MAXCSTACK).
+const maxScriptArgs = 4000
+
+// scriptCommit checks reads and applies writes. ARGV: number of reads, then for each read its
+// kind, number of arguments, the command and the expected reply; number of writes, then for each
+// write its number of arguments and the command. Returns {0, index of the changed read} or
+// {1, type, value, ...} with the reply of each write (s: string, i: integer, n: nil, e: error).
+const scriptCommit = `
+local i = 0
+local function arg() i = i + 1 return ARGV[i] end
+local function command()
+  local n, cmd = tonumber(arg()), {}
+  for j = 1, n do cmd[j] = arg() end
+  return cmd
+end
+local function value()
+  if arg() == 'n' then return false end
+  return arg()
+end
+for r = 1, tonumber(arg()) do
+  local kind, cmd = arg(), command()
+  local ok = true
+  if kind == 'v' then
+    ok = redis.call(unpack(cmd)) == value()
+  elseif kind == 'i' then
+    ok = redis.call(unpack(cmd)) == tonumber(arg())
+  elseif kind == 'a' then
+    local got, n = redis.call(unpack(cmd)), tonumber(arg())
+    ok = #got == n
+    for j = 1, n do
+      if got[j] ~= value() then ok = false end
+    end
+  else -- 'h' (HGETALL) and 'k' (HKEYS): compare as sets, the order may differ on the replica
+    local key, n = cmd[2], tonumber(arg())
+    ok = redis.call('HLEN', key) == n
+    for j = 1, n do
+      if kind == 'h' then
+        local f, v = arg(), arg()
+        if ok and redis.call('HGET', key, f) ~= v then ok = false end
+      elseif ok and redis.call('HEXISTS', key, arg()) == 0 then
+        ok = false
+      end
+    end
+  end
+  if not ok then return {0, r} end
+end
+local res = {1}
+for w = 1, tonumber(arg()) do
+  local rep = redis.pcall(unpack(command()))
+  if type(rep) == 'table' and rep.err then
+    res[#res + 1] = 'e'; res[#res + 1] = rep.err
+  elseif type(rep) == 'table' and rep.ok then
+    res[#res + 1] = 's'; res[#res + 1] = rep.ok
+  elseif type(rep) == 'number' then
+    res[#res + 1] = 'i'; res[#res + 1] = rep
+  elseif rep == false then
+    res[#res + 1] = 'n'; res[#res + 1] = ''
+  else
+    res[#res + 1] = 's'; res[#res + 1] = rep
+  end
+end
+return res
+`
+
+var commitScript = redis.NewScript(scriptCommit)
+
+// optimisticTx is the hook installed on the redis.Tx of an optimistic attempt.
+type optimisticTx struct {
+	m     *redisMeta
+	reads []redis.Cmder // served by the replica since the last commit
+	abort error         // why the transaction must run again with WATCH
+}
+
+// optimistic runs txf once optimistically. It returns fallback when txf must run again with WATCH.
+func (m *redisMeta) optimistic(ctx Context, txf func(tx *redis.Tx) error) (fallback bool, err error) {
+	o := &optimisticTx{m: m}
+	err = m.rdb.Watch(ctx, func(tx *redis.Tx) error {
+		tx.AddHook(o)
+		err := txf(tx)
+		if o.abort == nil && len(o.reads) > 0 && !errors.Is(err, redis.TxFailedErr) {
+			// no commit after these reads: the result must still be the master's
+			if e := o.commit(ctx, nil); e != nil {
+				return e
+			}
+		}
+		return err
+	}) // no keys: nothing is watched, no command reaches the master but EVALSHA
+	if o.abort != nil {
+		logger.Debugf("Optimistic transaction aborted: %s", o.abort)
+		m.replica.fallbacks.Add(1)
+		return true, nil
+	}
+	if errors.Is(err, redis.TxFailedErr) {
+		m.replica.conflicts.Add(1)
+	}
+	return false, err
+}
+
+func (o *optimisticTx) fail(cmd redis.Cmder, reason error) error {
+	if o.abort == nil {
+		o.abort = fmt.Errorf("%s: %w", cmd.Name(), reason)
+	}
+	cmd.SetErr(errOptimisticAbort)
+	return errOptimisticAbort
+}
+
+func (o *optimisticTx) DialHook(next redis.DialHook) redis.DialHook { return nil }
+
+func (o *optimisticTx) ProcessHook(next redis.ProcessHook) redis.ProcessHook {
+	return func(ctx context.Context, cmd redis.Cmder) error {
+		switch cmd.Name() {
+		case "watch", "unwatch":
+			cmd.(*redis.StatusCmd).SetVal("OK")
+			return nil
+		}
+		if o.abort != nil {
+			return o.fail(cmd, o.abort)
+		}
+		if readKind(cmd) == 0 {
+			return o.fail(cmd, errors.New("cannot be checked"))
+		}
+		err := o.m.replica.cli.Process(ctx, cmd)
+		if err != nil && err != redis.Nil {
+			return o.fail(cmd, err)
+		}
+		o.reads = append(o.reads, cmd)
+		return err
+	}
+}
+
+func (o *optimisticTx) ProcessPipelineHook(next redis.ProcessPipelineHook) redis.ProcessPipelineHook {
+	return func(ctx context.Context, cmds []redis.Cmder) error {
+		n := len(cmds)
+		multi := n >= 2 && cmds[0].Name() == "multi" && cmds[n-1].Name() == "exec"
+		if o.abort != nil {
+			for _, cmd := range cmds {
+				_ = o.fail(cmd, o.abort)
+			}
+			return errOptimisticAbort
+		}
+		if multi {
+			cmds[0].(*redis.StatusCmd).SetVal("OK")
+			return o.commit(ctx, cmds[1:n-1])
+		}
+		for _, cmd := range cmds {
+			if readKind(cmd) == 0 {
+				return o.commit(ctx, cmds) // writes in a plain pipeline: committed atomically here
+			}
+		}
+		pipe := o.m.replica.cli.Pipeline()
+		for _, cmd := range cmds {
+			_ = pipe.Process(ctx, cmd)
+		}
+		_, err := pipe.Exec(ctx)
+		for _, cmd := range cmds {
+			if e := cmd.Err(); e != nil && e != redis.Nil {
+				return o.fail(cmd, e)
+			}
+		}
+		o.reads = append(o.reads, cmds...)
+		return err
+	}
+}
+
+// readKind is how scriptCommit checks the reply of a read, 0 when it cannot.
+func readKind(cmd redis.Cmder) byte {
+	switch cmd.Name() {
+	case "get", "hget":
+		return 'v'
+	case "exists", "hexists", "hlen":
+		return 'i'
+	case "mget", "hmget", "lrange":
+		return 'a'
+	case "hgetall":
+		return 'h'
+	case "hkeys":
+		return 'k'
+	}
+	return 0
+}
+
+func appendCommand(args []interface{}, cmd redis.Cmder) []interface{} {
+	args = append(args, len(cmd.Args()))
+	return append(args, cmd.Args()...)
+}
+
+func appendValue(args []interface{}, v interface{}) []interface{} {
+	if v == nil {
+		return append(args, "n")
+	}
+	return append(args, "s", v)
+}
+
+// encodeRead appends a read and the reply the replica gave to it.
+func encodeRead(args []interface{}, cmd redis.Cmder) ([]interface{}, error) {
+	kind := readKind(cmd)
+	args = appendCommand(append(args, string(kind)), cmd)
+	switch c := cmd.(type) {
+	case *redis.StringCmd:
+		if c.Err() == redis.Nil {
+			return appendValue(args, nil), nil
+		}
+		return appendValue(args, c.Val()), nil
+	case *redis.IntCmd:
+		return append(args, c.Val()), nil
+	case *redis.BoolCmd:
+		if c.Val() {
+			return append(args, 1), nil
+		}
+		return append(args, 0), nil
+	case *redis.SliceCmd:
+		args = append(args, len(c.Val()))
+		for _, v := range c.Val() {
+			args = appendValue(args, v)
+		}
+		return args, nil
+	case *redis.StringSliceCmd:
+		args = append(args, len(c.Val()))
+		for _, v := range c.Val() {
+			if kind == 'k' {
+				args = append(args, v)
+			} else {
+				args = appendValue(args, v)
+			}
+		}
+		return args, nil
+	case *redis.MapStringStringCmd:
+		args = append(args, len(c.Val()))
+		for k, v := range c.Val() {
+			args = append(args, k, v)
+		}
+		return args, nil
+	}
+	return nil, fmt.Errorf("reply %T", cmd)
+}
+
+// commit sends the reads since the last commit and the writes in one EVALSHA.
+func (o *optimisticTx) commit(ctx context.Context, writes []redis.Cmder) error {
+	r := o.m.replica
+	k := r.ryw()
+	var incr *redis.IntCmd
+	if len(writes) > 0 && k.key != "" {
+		tracked := false
+		for _, w := range writes {
+			if k.is(w) {
+				tracked = true
+			}
+		}
+		if !tracked { // a plain pipeline: the ryw hook only sees MULTI/EXEC
+			incr = k.incr(ctx)
+			writes = append(writes, incr)
+		}
+	}
+	for _, w := range writes {
+		switch w.(type) {
+		case *redis.StatusCmd, *redis.IntCmd, *redis.BoolCmd, *redis.StringCmd:
+		default:
+			return o.fail(w, fmt.Errorf("reply %T", w))
+		}
+		if len(w.Args()) > maxScriptArgs {
+			return o.fail(w, fmt.Errorf("%d arguments", len(w.Args())))
+		}
+	}
+	for _, cmd := range o.reads {
+		if len(cmd.Args()) > maxScriptArgs {
+			return o.fail(cmd, fmt.Errorf("%d arguments", len(cmd.Args())))
+		}
+	}
+	args := []interface{}{len(o.reads)}
+	for _, cmd := range o.reads {
+		var err error
+		if args, err = encodeRead(args, cmd); err != nil {
+			return o.fail(cmd, err)
+		}
+	}
+	args = append(args, len(writes))
+	for _, w := range writes {
+		args = appendCommand(args, w)
+	}
+	res, err := commitScript.Run(ctx, o.m.rdb, nil, args...).Slice()
+	if err == nil && (len(res) == 0 || len(res) != 1+2*len(writes) && res[0] != int64(0)) {
+		err = fmt.Errorf("unexpected reply of scriptCommit: %v", res)
+	}
+	if err == nil && res[0] == int64(0) {
+		err = redis.TxFailedErr
+	}
+	if err != nil {
+		for _, w := range writes {
+			w.SetErr(err)
+		}
+		return err
+	}
+	o.reads = o.reads[:0]
+	var first error
+	for i, w := range writes {
+		typ, val := res[1+2*i], res[2+2*i]
+		switch typ {
+		case "e":
+			w.SetErr(errors.New(fmt.Sprint(val)))
+		case "n":
+			w.SetErr(redis.Nil)
+		default:
+			setReply(w, val)
+		}
+		if first == nil && w.Err() != nil {
+			first = w.Err()
+		}
+	}
+	if incr != nil && incr.Err() == nil {
+		maxInt64(&r.required, incr.Val())
+	}
+	return first
+}
+
+func setReply(cmd redis.Cmder, val interface{}) {
+	var s string
+	var n int64
+	switch v := val.(type) {
+	case int64:
+		n, s = v, strconv.FormatInt(v, 10)
+	case string:
+		s = v
+		n, _ = strconv.ParseInt(v, 10, 64)
+	}
+	switch c := cmd.(type) {
+	case *redis.StatusCmd:
+		c.SetVal(s)
+	case *redis.IntCmd:
+		c.SetVal(n)
+	case *redis.BoolCmd:
+		c.SetVal(n != 0 || s == "OK")
+	case *redis.StringCmd:
+		c.SetVal(s)
+	}
+}
