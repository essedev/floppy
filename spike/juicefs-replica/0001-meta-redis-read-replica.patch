+// A blackholed master (no answer, nothing refused): offline after master-timeout of silence, no
+// EROFS before it, then every write fails at once with EROFS.
+func TestRedisReplicaOfflineWrites(t *testing.T) {
+	e := newReplicaEnv(t)
+	cp := newTCPProxy(t, e.master)
+	m := e.newMeta(t, "127.0.0.1:"+cp.port(), replicaQuery(e, "2s")+"&master-timeout=3s")
+	e.format(t, m)
+	waitMode(t, m, replicaModeReplica, 5*time.Second)
+	ctx := Background()
+	var dir, ino Ino
+	var attr Attr
+	if st := m.Mkdir(ctx, RootInode, "d", 0755, 0, 0, &dir, &attr); st != 0 {
+		t.Fatalf("mkdir: %s", st)
+	}
+	if st := m.Create(ctx, dir, "f", 0644, 0, 0, &ino, &attr); st != 0 {
+		t.Fatalf("create: %s", st)
+	}
+
+	cut := time.Now()
+	cp.blackhole.Store(true)
+	type result struct {
+		st         syscall.Errno
+		start, end time.Time
+	}
+	results := make(chan result, 1000)
+	stop := make(chan struct{})
+	var wg sync.WaitGroup
+	for w := 0; w < 4; w++ { // writers busy from the cut on
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for {
+				select {
+				case <-stop:
+					return
+				default:
+				}
+				start := time.Now()
+				st := m.SetXattr(ctx, ino, "user.v", []byte("x"), 0)
+				results <- result{st, start, time.Now()}
+				if st != 0 {
+					time.Sleep(10 * time.Millisecond) // EROFS is immediate: do not fill results
+				}
+			}
+		}()
+	}
+	waitMode(t, m, replicaModeOffline, 6*time.Second)
+	offlineAt := time.Unix(0, m.replica.offline.Load().since.Load())
+	time.Sleep(200 * time.Millisecond)
+	close(stop)
+	wg.Wait()
+	close(results)
+	var early, erofs, other int
+	var slowest time.Duration
+	for r := range results {
+		switch {
+		case r.st == syscall.EROFS && r.end.Before(offlineAt):
+			early++
+		case r.st == syscall.EROFS:
+			erofs++
+			if r.start.After(offlineAt) && r.end.Sub(r.start) > slowest {
+				slowest = r.end.Sub(r.start)
+			}
+		default:
+			other++
+		}
+	}
+	t.Logf("blackhole: offline %s after the cut; %d EROFS before it, %d after (slowest started offline: %s), %d other results",
+		offlineAt.Sub(cut).Truncate(time.Millisecond), early, erofs, slowest, other)
+	if d := offlineAt.Sub(cut); d < 2500*time.Millisecond || d > 4500*time.Millisecond {
+		t.Fatalf("offline %s after the cut, expected about master-timeout (3s)", d)
+	}
+	if early > 0 || erofs == 0 || slowest > 50*time.Millisecond {
+		t.Fatalf("%d EROFS before offline, %d after, slowest %s", early, erofs, slowest)
+	}
+	var got Ino
+	for _, st := range []syscall.Errno{
+		m.Create(ctx, dir, "g", 0644, 0, 0, &got, &attr),
+		m.Mkdir(ctx, dir, "e", 0755, 0, 0, &got, &attr),
+		m.SetAttr(ctx, ino, SetAttrMode, 0, &Attr{Mode: 0600}),
+		m.Write(ctx, ino, 0, 0, Slice{Id: 1, Size: 10, Len: 10}, time.Now()),
+	} {
+		if st != syscall.EROFS {
+			t.Fatalf("write offline: %s, expected EROFS", st)
+		}
+	}
+	var found Ino
+	if st := m.Lookup(ctx, dir, "f", &found, &attr, false); st != 0 || found != ino {
+		t.Fatalf("lookup offline: %s", st)
+	}
+
+	cp.blackhole.Store(false)
+	cp.closeConns()
+	t.Logf("master back: replica mode after %s", waitMode(t, m, replicaModeReplica, 10*time.Second))
+	if st := m.SetXattr(ctx, ino, "user.v", []byte("after"), 0); st != 0 {
+		t.Fatalf("setxattr after: %s", st)
+	}
+	var v []byte
+	if st := m.GetXattr(ctx, ino, "user.v", &v); st != 0 || string(v) != "after" {
+		t.Fatalf("getxattr after: %q (%s)", v, st)
+	}
+}
