+package cmd
+
+import (
+	"os"
+	"slices"
+	"sort"
+	"testing"
+
+	"github.com/urfave/cli/v2"
+)
+
+// runWithStorageFlags runs check inside a command that has the storage key flags.
+func runWithStorageFlags(t *testing.T, args []string, check func(c *cli.Context)) {
+	t.Helper()
+	app := &cli.App{
+		Name: "juicefs",
+		Commands: []*cli.Command{{
+			Name: "config",
+			Flags: []cli.Flag{
+				&cli.StringFlag{Name: "access-key"},
+				&cli.StringFlag{Name: "secret-key"},
+				&cli.StringFlag{Name: "session-token"},
+				&cli.IntFlag{Name: "trash-days"},
+			},
+			Action: func(c *cli.Context) error {
+				if err := keysFromEnv(c); err != nil {
+					return err
+				}
+				check(c)
+				return nil
+			},
+		}},
+	}
+	if err := app.Run(append([]string{"juicefs", "config"}, args...)); err != nil {
+		t.Fatalf("run: %s", err)
+	}
+}
+
+func TestKeysFromEnvAreSetFlags(t *testing.T) {
+	t.Setenv("ACCESS_KEY", "env-ak")
+	t.Setenv("SECRET_KEY", "env-sk")
+	t.Setenv("SESSION_TOKEN", "")
+	runWithStorageFlags(t, []string{"--trash-days", "3", "meta-url"}, func(c *cli.Context) {
+		names := c.LocalFlagNames()
+		sort.Strings(names)
+		if want := []string{"access-key", "secret-key", "trash-days"}; !slices.Equal(names, want) {
+			t.Fatalf("flags %v, want %v", names, want)
+		}
+		if c.String("access-key") != "env-ak" || c.String("secret-key") != "env-sk" {
+			t.Fatalf("keys %q %q", c.String("access-key"), c.String("secret-key"))
+		}
+		if !c.IsSet("secret-key") || c.IsSet("session-token") {
+			t.Fatalf("IsSet secret-key %v session-token %v", c.IsSet("secret-key"), c.IsSet("session-token"))
+		}
+	})
+	if os.Getenv("SECRET_KEY") != "" || os.Getenv("ACCESS_KEY") != "" {
+		t.Fatal("the variables must not reach child processes")
+	}
+}
+
+func TestKeysOnTheCommandLineWin(t *testing.T) {
+	t.Setenv("ACCESS_KEY", "env-ak")
+	runWithStorageFlags(t, []string{"--access-key", "argv-ak", "meta-url"}, func(c *cli.Context) {
+		if c.String("access-key") != "argv-ak" {
+			t.Fatalf("access-key %q", c.String("access-key"))
+		}
+	})
+}
+
+func TestNoKeysInTheEnvironmentChangeNothing(t *testing.T) {
+	t.Setenv("ACCESS_KEY", "")
+	t.Setenv("SECRET_KEY", "")
+	t.Setenv("SESSION_TOKEN", "")
+	runWithStorageFlags(t, []string{"meta-url"}, func(c *cli.Context) {
+		if names := c.LocalFlagNames(); len(names) != 0 {
+			t.Fatalf("flags %v", names)
+		}
+	})
+}
