+package cmd
+
+import (
+	"os"
+
+	"github.com/urfave/cli/v2"
+)
+
+// storageKeyEnv maps the object storage key flags to the environment variables
+// that may carry them instead, so a key never has to appear in a process's
+// arguments.
+var storageKeyEnv = []struct{ flag, env string }{
+	{"access-key", "ACCESS_KEY"},
+	{"secret-key", "SECRET_KEY"},
+	{"session-token", "SESSION_TOKEN"},
+}
+
+// keysFromEnv sets the storage key flags of c that are not given on the
+// command line from ACCESS_KEY, SECRET_KEY and SESSION_TOKEN, and removes
+// those variables. `format` and `config` then change the keys of an existing
+// volume as if the flags had been given.
+func keysFromEnv(c *cli.Context) error {
+	for _, k := range storageKeyEnv {
+		v := os.Getenv(k.env)
+		if v == "" || c.IsSet(k.flag) {
+			continue
+		}
+		if err := c.Set(k.flag, v); err != nil {
+			return err
+		}
+		_ = os.Unsetenv(k.env)
+	}
+	return nil
+}
