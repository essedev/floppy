From 16c1da8716ada6365ce36c6f0a8032e30f94248f Mon Sep 17 00:00:00 2001
From: Simone Salerno <doppiaesse@proton.me>
Date: Sat, 17 Oct 2026 21:00:00 +0200
Subject: [PATCH] cmd: format and config take the storage keys from the
 environment

`juicefs format` reads ACCESS_KEY, SECRET_KEY and SESSION_TOKEN only when it
creates a volume: on an existing volume, and in `juicefs config`, only flags
given on the command line change, so changing a volume's key meant putting
the secret in the process's arguments, where `ps` shows it.

A key flag not given on the command line is now taken from its variable
(access-key from ACCESS_KEY, secret-key from SECRET_KEY, session-token from
SESSION_TOKEN) and counts as given: the key of an existing volume changes,
and config's sanity check runs with the new key before saving it. The
variables are removed afterwards, as format already did for a new volume. A
flag on the command line wins over its variable.

Tests: cmd/storage_env_test.go, and in spike/juicefs-replica/test.sh a
config against Garage that rotates a volume's key from the environment.
---
 cmd/config.go           |  3 ++
 cmd/format.go           |  3 ++
 cmd/storage_env.go      | 50 ++++++++++++++++++++++
 cmd/storage_env_test.go | 95 +++++++++++++++++++++++++++++++++++++++++
 4 files changed, 151 insertions(+)
 create mode 100644 cmd/storage_env.go
 create mode 100644 cmd/storage_env_test.go

diff --git a/cmd/config.go b/cmd/config.go
index d431fdc..0e6f04d 100644
--- a/cmd/config.go
+++ b/cmd/config.go
@@ -162,6 +162,9 @@ func userConfirmed() bool {
 func config(ctx *cli.Context) error {
 	setup(ctx, 1)
 	removePassword(ctx.Args().Get(0))
+	if err := keysFromEnv(ctx); err != nil {
+		return err
+	}
 	m := meta.NewClient(ctx.Args().Get(0), nil)
 
 	format, err := m.Load(false)
diff --git a/cmd/format.go b/cmd/format.go
index a20f882..5580582 100644
--- a/cmd/format.go
+++ b/cmd/format.go
@@ -423,6 +423,9 @@ func maxVersion(v1, v2 string) string {
 func format(c *cli.Context) error {
 	setup(c, 2)
 	removePassword(c.Args().Get(0))
+	if err := keysFromEnv(c); err != nil {
+		return err
+	}
 	m := meta.NewClient(c.Args().Get(0), nil)
 	name := c.Args().Get(1)
 	validName := regexp.MustCompile(`^[a-z0-9][a-z0-9\-]{1,61}[a-z0-9]$`)
